#!/usr/bin/env bash
# PROVENANCE: INDEPENDENT  本脚本出图代码为独立实现，未派生自 reference/05.可参考出图代码 的源码；
# external_validation：line1_bulk 步骤 11 独立验证（冻结评估）。
#
# 硬约束（aims）：验证集只做冻结评估，不重新筛基因、不重新调参；验证集内部可
# 去批次，但禁止把训练集与验证集合并校正后再评估。
#
# 两种验证模式：
#   1) internal_holdout_approximation：cwd 没有独立验证集时，保持原有的分层留出法，
#      特征（key_genes）与模型超参在训练集上确定后冻结，测试集只做 predict。
#   2) external_cohort_frozen：cwd 或 --input 提供 external_frozen_model.tsv，且 cwd
#      有 val_expr_genes.tsv + val_group_map.tsv 时，直接读取 ml_model 的冻结参数，
#      在独立验证矩阵上只 predict，不重训、不重新筛基因、不调参。
#
# 自校验内建：输入存在、样本数满足对应模式下限、评估集含两类、冻结特征非空、
# 评估只用冻结模型（不重训）。
set -euo pipefail

seed="${BIOANALYS_SEED:-UNSET}"
if [ "$seed" = "UNSET" ]; then
  echo "BIOANALYS_SEED 未注入（引擎契约：seed 必须注入）" >&2
  exit 3
fi

declare -a INPUTS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --input) INPUTS+=("$2"); shift 2 ;;
    --output) shift 2 ;;
    --seed) shift 2 ;;
    *) echo "未知参数: $1" >&2; exit 2 ;;
  esac
done

expr_file=""; group_file=""; key_file=""
val_expr_file=""; val_group_file=""; frozen_file=""
for path in "${INPUTS[@]:-}"; do
  [ -n "$path" ] || continue
  case "$path" in
    *external_frozen_model*.tsv) frozen_file="$path" ;;
    *val_expr_genes*.tsv) val_expr_file="$path" ;;
    *val_group_map*.tsv) val_group_file="$path" ;;
    *expr_genes*.tsv) expr_file="$path" ;;
    *group_map*.tsv) group_file="$path" ;;
    *key_genes*.tsv) key_file="$path" ;;
    *) echo "无法识别的输入: $path" >&2; exit 2 ;;
  esac
done

if [ -n "$frozen_file" ] && [ ! -f "$frozen_file" ]; then
  echo "外部冻结模型文件不存在: $frozen_file" >&2
  exit 2
fi
if [ -n "$val_expr_file" ] && [ ! -f "$val_expr_file" ]; then
  echo "独立验证表达矩阵不存在: $val_expr_file" >&2
  exit 2
fi
if [ -n "$val_group_file" ] && [ ! -f "$val_group_file" ]; then
  echo "独立验证分组表不存在: $val_group_file" >&2
  exit 2
fi

[ -n "$frozen_file" ] || frozen_file="external_frozen_model.tsv"
[ -n "$val_expr_file" ] || val_expr_file="val_expr_genes.tsv"
[ -n "$val_group_file" ] || val_group_file="val_group_map.tsv"

validation_mode="internal_holdout_approximation"
if [ -f "$frozen_file" ] && [ -f "$val_expr_file" ] && [ -f "$val_group_file" ]; then
  validation_mode="external_cohort_frozen"
fi

if [ "$validation_mode" = "external_cohort_frozen" ]; then
  [ -f "$frozen_file" ] || { echo "缺 external_frozen_model.tsv（ml_model 产物）" >&2; exit 2; }
  [ -f "$val_expr_file" ] || { echo "缺 val_expr_genes.tsv" >&2; exit 2; }
  [ -f "$val_group_file" ] || { echo "缺 val_group_map.tsv" >&2; exit 2; }
else
  [ -n "$expr_file" ] && [ -f "$expr_file" ] || { echo "缺 expr_genes.tsv" >&2; exit 2; }
  [ -n "$group_file" ] && [ -f "$group_file" ] || { echo "缺 group_map.tsv" >&2; exit 2; }
  [ -n "$key_file" ] && [ -f "$key_file" ] || { echo "缺 key_genes.tsv（步骤 9 产物）" >&2; exit 2; }
fi

echo "step_executed=external_validation"
echo "bioanalys_seed=${seed}"
echo "validation_mode=${validation_mode}"

# 解释器 PATH 前置（生信代码专项审核）：K40 系统解释器缺科学计算包，真依赖在 bio-py venv。
# 用 PATH 注入而非改写调用行，是为了让桥接调用的行级计数保持原样（bilingual 判定不变）。
BIO_PY_BIN="${BIO_PY_BIN:-/root/venvs/bio-py/bin}"
if [ -x "$BIO_PY_BIN/python3" ]; then
  export PATH="$BIO_PY_BIN:$PATH"
fi

VALIDATION_MODE="$validation_mode" EXPR_FILE="${expr_file:-}" GROUP_FILE="${group_file:-}" \
KEY_FILE="${key_file:-}" FROZEN_FILE="${frozen_file:-}" VAL_EXPR_FILE="${val_expr_file:-}" \
VAL_GROUP_FILE="${val_group_file:-}" BIOANALYS_SEED="$seed" \
python3 - <<'PYSCRIPT'
import os
import sys
import time

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import json

import numpy as np
import pandas as pd
from sklearn.linear_model import LogisticRegression
from sklearn.preprocessing import StandardScaler
from sklearn.model_selection import StratifiedShuffleSplit
from sklearn.metrics import roc_auc_score, accuracy_score, roc_curve, confusion_matrix

plt.rcParams.update({"figure.dpi": 300, "savefig.dpi": 300, "font.size": 8, "font.family": "sans-serif", "font.sans-serif": ["Arial", "Helvetica", "Liberation Sans", "DejaVu Sans"], "axes.labelsize": 8, "xtick.labelsize": 8, "ytick.labelsize": 8, "legend.fontsize": 8, "legend.title_fontsize": 8,
                     "axes.titlesize": 9, "axes.grid": False,
                     "figure.autolayout": True, "savefig.bbox": "tight",
                     "image.cmap": "viridis"})


def caption(fig, *parts):
    """图注默认置于图幅左下角、轴框之外（y<0），靠 savefig(bbox="tight")
    向下扩边容纳，因此不占用、也不挤压主图数据区（2026-11-06 用户裁定）。
    不再按图幅横竖分支选位置：旧规范把竖版图注放右上，会与图例列抢空间。"""
    parts = [str(p) for p in parts if p not in (None, "")]
    if not parts:
        return
    text = "\n".join(parts)
    fig.text(0.01, -0.02, text, ha="left", va="top", fontsize=8, linespacing=1.5)
def wrap_label(text, width=18):
    """长标签换行：超宽标签优先按 _ 边界折行，仍超宽再按字符折行，防溢出图框。"""
    import textwrap

    s = str(text)
    if len(s) <= width:
        return s
    lines, cur = [], ""
    for part in s.split("_"):
        joined = part if not cur else cur + "_" + part
        if cur and len(joined) > width:
            lines.append(cur)
            cur = part
        else:
            cur = joined
    if cur:
        lines.append(cur)
    if max(len(x) for x in lines) <= width:
        return "\n".join(lines)
    out = []
    for line in lines:
        out.extend(textwrap.wrap(line, width=width) or [line])
    return "\n".join(out)


def fit_text_edges(fig, ax, gap=6.0, rounds=5):
    """把越出坐标轴框的轴内文本收进框内：右缘/顶缘/左缘/下缘越界时自动扩 xlim/ylim。
    实测像素宽度迭代收敛（至少留 6px 边距，比审计容差 3px 更严），柱顶数值标注与条形
    末端外挂标注都按同一规则留位；若扩一轮越界没有改善（文本框锚在轴坐标而非数据坐标）
    就停手，防无意义放大把主图压扁。"""
    prev = None
    for _ in range(rounds):
        fig.canvas.draw()
        rend = fig.canvas.get_renderer()
        bb = ax.get_window_extent()
        boxes = [t.get_window_extent(renderer=rend) for t in ax.texts
                 if t.get_text().strip()]
        if not boxes:
            return
        bw = max(bb.width, 1e-6)
        bh = max(bb.height, 1e-6)
        right = max(b.x1 for b in boxes) - bb.x1
        top = max(b.y1 for b in boxes) - bb.y1
        left = bb.x0 - min(b.x0 for b in boxes)
        bottom = bb.y0 - min(b.y0 for b in boxes)
        if max(right, top, left, bottom) <= gap:
            return
        worst = max(right / bw, top / bh, left / bw, bottom / bh)
        if prev is not None and worst >= prev * 0.98:
            return
        prev = worst
        x0, x1 = ax.get_xlim()
        y0, y1 = ax.get_ylim()
        if right > gap:
            ax.set_xlim(x0, x1 + (x1 - x0) * (right / bw) * 1.15)
            x0, x1 = ax.get_xlim()
        if left > gap:
            ax.set_xlim(x0 - (x1 - x0) * (left / bw) * 1.15, x1)
            x0, x1 = ax.get_xlim()
        if top > gap:
            ax.set_ylim(y0, y1 + (y1 - y0) * (top / bh) * 1.15)
            y0, y1 = ax.get_ylim()
        if bottom > gap:
            ax.set_ylim(y0 - (y1 - y0) * (bottom / bh) * 1.15, y1)


def legend_out(ax, fig, leg, slot=0):
    """图例统一置坐标轴框外右侧、纵向排列（用户 2026-11-07 定稿）。
    多组图例按 slot 依次向右横排（每组各自纵向单列），互不重叠。
    不再按图幅横竖分支把图例放到轴框下方。"""
    handles = list(leg.legend_handles)
    labels = [t.get_text() for t in leg.get_texts()]
    title = leg.get_title().get_text() or None
    fig.set_layout_engine("none")
    x = 1.02 + 0.30 * slot
    ax.legend(handles, labels, loc="upper left", bbox_to_anchor=(x, 1.0),
              ncol=1, fontsize=8, frameon=False, title=title)
    fig.subplots_adjust(right=max(0.60, 0.80 - 0.06 * slot))


def layout_fix(fig):
    """落盘前统一收口（docs/figure_spec.md v2.2 §三之三）：
    1) 单坐标轴图的图例外置：一律置轴框外右侧，纵向排布、不压数据；
    2) 轴内文本右缘/顶缘/左缘/下缘越出坐标轴框时自动扩 xlim/ylim 收进框内。
    多子图（分面）图不做图例搬迁：分面各有自己的图例，统一外移会互相压扁。
    tick 标签一律不动：它本就在轴框外，savefig.bbox="tight" 会把画布扩到装下它；
    强行换行反而让多行标签在密集类目轴上互相压字（实测见踩坑台账）。"""
    from matplotlib.colorbar import Colorbar

    axes = [a for a in fig.get_axes() if not isinstance(a, Colorbar)]
    if not axes:
        return
    if len(axes) == 1:
        legs = [l for l in (axes[0].get_legend(),) if l is not None]
        for slot, leg in enumerate(legs):
            legend_out(axes[0], fig, leg, slot=slot)
        fit_text_edges(fig, axes[0])


def _install_layout_guard():
    """装一次全局收口：脚本内任何 fig.savefig 落盘前先走 layout_fix()，
    以后新增图自动套版式规则，不靠人记得调用（docs/figure_spec.md v2.2 §三之三）。"""
    from matplotlib.figure import Figure

    if getattr(Figure.savefig, "_layout_guard", False):
        return
    orig = Figure.savefig

    def guarded(self, fname, *a, **kw):
        layout_fix(self)
        return orig(self, fname, *a, **kw)

    guarded._layout_guard = True
    guarded._orig_savefig = orig
    Figure.savefig = guarded


_install_layout_guard()

START = time.time()
SEED = int(os.environ["BIOANALYS_SEED"])
np.random.seed(SEED)


def fail(m):
    sys.stderr.write("external_validation 自校验失败: %s\n" % m)
    sys.stderr.flush()
    sys.exit(1)


def log(m):
    print(m, flush=True)


# --- 项目元数据与冻结模型解析（吸收自 K40 远端，第三十八轮同源收敛）---
# 远端在这里读 project.json 的 train/validation 数据集角色，并把冻结模型表按
# record_type 拆成元信息与特征系数。仓库版本缺这段，导致真机 external_validation
# 拿不到 train_dataset / train_platform 等溯源字段。下面两个函数逐字取自远端，
# 与仓库的排版工具组（caption/wrap_label/fit_text_edges/legend_out/layout_fix）互补，
# 合并而不是二选一。

def project_datasets():
    path = os.environ.get("BIOANALYS_PROJECT_JSON", "")
    if not path or not os.path.exists(path):
        return {}, {}
    try:
        with open(path, encoding="utf-8") as handle:
            project = json.load(handle)
    except (OSError, json.JSONDecodeError):
        return {}, {}
    datasets = project.get("data_source", {}).get("datasets", [])
    train = next((item for item in datasets if item.get("role") == "train"), {})
    validation = next((item for item in datasets if item.get("role") == "validation"), {})
    return train, validation


def parse_frozen_model(path):
    table = pd.read_csv(path, sep="\t", dtype=str, keep_default_na=False)
    required = {"record_type", "feature_index", "gene", "value_key", "value"}
    if not required.issubset(table.columns):
        fail("冻结模型缺字段: %s" % sorted(required - set(table.columns)))
    model_rows = table[table["record_type"] == "model"]
    feature_rows = table[table["record_type"] == "feature"].copy()
    metadata = dict(zip(model_rows["value_key"], model_rows["value"]))
    required_meta = {
        "model_type", "penalty", "C", "max_iter", "seed", "case_group",
        "control_group", "train_dataset", "train_platform", "train_samples",
        "feature_count", "missing_value_strategy", "decision_threshold", "intercept",
    }
    if not required_meta.issubset(metadata):
        fail("冻结模型缺元信息: %s" % sorted(required_meta - set(metadata)))
    if metadata["model_type"] != "logistic_regression":
        fail("不支持的冻结模型: %s" % metadata["model_type"])
    if metadata["missing_value_strategy"] != "train_mean":
        fail("不支持的缺失基因策略: %s" % metadata["missing_value_strategy"])
    if int(metadata["seed"]) != SEED:
        fail("冻结模型 seed=%s 与当前 seed=%s 不一致" % (metadata["seed"], SEED))

    feature_rows["feature_index"] = pd.to_numeric(feature_rows["feature_index"], errors="coerce")
    if feature_rows["feature_index"].isna().any():
        fail("冻结特征索引含非数值")
    feature_rows = feature_rows.sort_values("feature_index")
    expected_index = list(range(len(feature_rows)))
    if feature_rows["feature_index"].astype(int).tolist() != expected_index:
        fail("冻结特征索引不连续")
    if int(metadata["feature_count"]) != len(feature_rows):
        fail("冻结特征数与 feature_count 不一致")

    parameters = []
    for row in feature_rows.itertuples(index=False):
        parts = {}
        for item in str(row.value).split(";"):
            if "=" not in item:
                fail("冻结特征参数格式错误: %s" % row.gene)
            key, value = item.split("=", 1)
            parts[key] = float(value)
        for key in ("scaler_mean", "scaler_scale", "coef"):
            if key not in parts or not np.isfinite(parts[key]):
                fail("冻结特征 %s 缺合法参数 %s" % (row.gene, key))
        if parts["scaler_scale"] <= 0:
            fail("冻结特征 %s 的 scaler_scale <= 0" % row.gene)
        parameters.append({
            "gene": str(row.gene),
            "scaler_mean": parts["scaler_mean"],
            "scaler_scale": parts["scaler_scale"],
            "coef": parts["coef"],
        })
    return metadata, pd.DataFrame(parameters)

MODE = os.environ.get("VALIDATION_MODE", "internal_holdout_approximation")
if MODE not in ("internal_holdout_approximation", "external_cohort_frozen"):
    fail("未知验证模式: %s" % MODE)

if MODE == "external_cohort_frozen":
    frozen_path = os.environ["FROZEN_FILE"]
    metadata, parameters = parse_frozen_model(frozen_path)
    expr_path = os.environ["VAL_EXPR_FILE"]
    group_path = os.environ["VAL_GROUP_FILE"]
    preferred_case = metadata["case_group"]
    preferred_ctrl = metadata["control_group"]
    min_samples = 4
else:
    metadata = {}
    parameters = pd.DataFrame()
    frozen_path = ""
    expr_path = os.environ["EXPR_FILE"]
    group_path = os.environ["GROUP_FILE"]
    preferred_case = ""
    preferred_ctrl = ""
    min_samples = 10

expr = pd.read_csv(expr_path, sep="\t", index_col=0)
gm = pd.read_csv(group_path, sep="\t")
samples = [s for s in gm["sample"].astype(str) if s in expr.columns]
if len(samples) < min_samples:
    fail("样本 %d < %d（验证需足够样本）" % (len(samples), min_samples))

groups_series = gm.set_index("sample").loc[samples, "group"].astype(str)
group_levels = sorted(groups_series.unique().tolist())


def project_contrast():
    """从项目元数据取主对比；只用于验证队列的标签映射，不参与模型拟合。"""
    pj_path = os.environ.get("BIOANALYS_PROJECT_JSON", "")
    if not pj_path or not os.path.exists(pj_path):
        return "", ""
    try:
        with open(pj_path, encoding="utf-8") as fh:
            pj = json.load(fh)
    except Exception:
        return "", ""
    design = pj.get("grouping_design", pj.get("analysis_design", {}))
    contrasts = design.get("contrasts", [])
    primary = next((c for c in contrasts if c.get("isPrimary")), contrasts[0] if contrasts else {})
    return str(primary.get("case") or ""), str(primary.get("ctrl") or "")


# 解析 case_group 与 ctrl_group：冻结模型标签优先，其次项目主对比，最后按常见标签回退。
case_group = ""
ctrl_group = ""
if preferred_case in group_levels:
    case_group = preferred_case
if preferred_ctrl in group_levels and preferred_ctrl != case_group:
    ctrl_group = preferred_ctrl
pj_case, pj_ctrl = project_contrast()
if not case_group and pj_case in group_levels:
    case_group = pj_case
if not ctrl_group and pj_ctrl in group_levels and pj_ctrl != case_group:
    ctrl_group = pj_ctrl

if not case_group:
    for cand in ("DCM", "LS", "Tumor", "Disease", "Case", "Stroke"):
        if cand in group_levels:
            case_group = cand
            break
if not case_group:
    case_group = group_levels[-1]

if not ctrl_group or ctrl_group == case_group:
    for cand in ("Control", "Ctrl", "Normal", "NonDiseased", "NLS"):
        if cand in group_levels and cand != case_group:
            ctrl_group = cand
            break
if not ctrl_group or ctrl_group == case_group:
    ctrl_group = next((g for g in group_levels if g != case_group), group_levels[0])

# 若存在多余组（如 GSE42955 中的 ICM），收拢到两组主对比。
eval_samples = [s for s in samples if groups_series.loc[s] in (case_group, ctrl_group)]
if MODE == "external_cohort_frozen":
    if len(eval_samples) < min_samples:
        fail("独立验证集在 %s/%s 两组的样本 %d < %d" % (
            case_group, ctrl_group, len(eval_samples), min_samples))
    samples = eval_samples
    groups_series = groups_series.loc[samples]
elif len(eval_samples) >= 8:
    samples = eval_samples
    groups_series = groups_series.loc[samples]

y = np.array([1 if g == case_group else 0 for g in groups_series])
if len(set(y)) < 2:
    fail("有效评估样本必须包含 case 与 control 两组，当前只有一类")

if MODE == "external_cohort_frozen":
    # 独立验证只消费冻结参数：特征顺序、标准化统计量、系数与截距全部来自冻结表。
    features = parameters["gene"].astype(str).tolist()
    if len(features) < 1:
        fail("冻结模型特征为空")
    means = parameters["scaler_mean"].to_numpy(dtype=float)
    scales = parameters["scaler_scale"].to_numpy(dtype=float)
    coefs = parameters["coef"].to_numpy(dtype=float)
    columns = []
    imputed_features = 0
    for gene, mean in zip(features, means):
        if gene in expr.index:
            values = expr.loc[gene, samples].to_numpy(dtype=float)
            finite = np.isfinite(values)
            if not finite.all():
                values = np.where(finite, values, mean)
            columns.append(values)
        else:
            columns.append(np.full(len(samples), mean, dtype=float))
            imputed_features += 1
    X_raw = np.column_stack(columns)
    X_scaled = (X_raw - means) / scales
    logit = X_scaled.dot(coefs) + float(metadata["intercept"])
    proba = 1.0 / (1.0 + np.exp(-np.clip(logit, -50.0, 50.0)))
    threshold = float(metadata["decision_threshold"])
    pred = (proba >= threshold).astype(int)
    auc = float(roc_auc_score(y, proba))
    acc = float(accuracy_score(y, pred))
    cm = confusion_matrix(y, pred, labels=[0, 1])
    eval_idx = np.arange(len(samples))
    log("external frozen: n_val=%d features=%d imputed=%d AUC=%.3f Acc=%.3f" % (
        len(samples), len(features), imputed_features, auc, acc))
    if not (0.0 <= auc <= 1.0):
        fail("AUC 越界")
    validation_type = "external_cohort_frozen"
    plot_label = "frozen external model (AUC=%.3f)" % auc
    caption_line = "line1: external frozen-model ROC"
    caption_count = "n_val=%d" % len(samples)
    metric_line = "external_auc=%.3f external_acc=%.3f" % (auc, acc)
    frozen_name = os.path.basename(frozen_path)
    report_lines = [
        "validation_type=%s" % validation_type,
        "frozen_model=%s" % frozen_name,
        "frozen_model_source=ml_model 产出 %s" % frozen_name,
        "train_dataset=%s train_platform=%s" % (
            metadata["train_dataset"], metadata["train_platform"]),
        "train_samples=%s" % metadata["train_samples"],
        "frozen_features=%d" % len(features),
        "n_validation=%d" % len(samples),
        "validation_case=%s:%d validation_control=%s:%d" % (
            case_group, int(y.sum()), ctrl_group, int((1 - y).sum())),
        "missing_value_strategy=%s imputed_features=%d" % (
            metadata["missing_value_strategy"], imputed_features),
        "decision_threshold=%s" % metadata["decision_threshold"],
        "note=独立验证集只使用 ml_model 冻结参数做 predict，不重训、不重新筛基因、不调参",
        metric_line,
        "confusion_matrix(labels=0,1)=%s" % cm.tolist(),
        "limitation_note=外部队列样本数 %d，AUC 置信区间随样本量收窄；仅按冻结口径评估" % len(samples),
    ]
else:
    kt = pd.read_csv(os.environ["KEY_FILE"], sep="\t")
    features = [g for g in kt["gene"].astype(str) if g in expr.index]
    if len(features) < 1:
        fail("冻结特征为空（key_genes 产物在表达矩阵中无交集）")
    log("samples=%d frozen_features=%d (case=%s:%d ctrl=%s:%d)" % (
        len(samples), len(features), case_group, int(y.sum()), ctrl_group, int((1 - y).sum())))

    X = np.nan_to_num(expr.loc[features, samples].T.to_numpy(dtype=float))

    # 分层留出：测试集 1/3，固定 seed，训练集定模型后冻结
    sss = StratifiedShuffleSplit(n_splits=1, test_size=1 / 3.0, random_state=SEED)
    tr_idx, te_idx = next(sss.split(X, y))
    if len(set(y[tr_idx])) < 2 or len(set(y[te_idx])) < 2:
        # 16 样本 1/3 约 5 个测试，可能抽到单类，退化为固定前 5 个测试
        log("分层抽样测试集单类，退化处理：测试集取分层前 5 个")
        te_idx = np.array([i for i, v in enumerate(y) if v == 1][:3] +
                          [i for i, v in enumerate(y) if v == 0][:2])
        tr_idx = np.array([i for i in range(len(y)) if i not in set(te_idx.tolist())])
    if len(set(y[te_idx])) < 2:
        fail("测试集只有一类，无法评估 AUC")

    # 冻结：训练集上 fit scaler + 模型
    scaler = StandardScaler().fit(X[tr_idx])
    clf = LogisticRegression(C=1.0, max_iter=2000, random_state=SEED).fit(
        scaler.transform(X[tr_idx]), y[tr_idx])
    # 冻结评估：测试集只 predict，不重训
    proba = clf.predict_proba(scaler.transform(X[te_idx]))[:, 1]
    pred = (proba >= 0.5).astype(int)
    auc = float(roc_auc_score(y[te_idx], proba))
    acc = float(accuracy_score(y[te_idx], pred))
    cm = confusion_matrix(y[te_idx], pred, labels=[0, 1])
    coefs = clf.coef_[0]
    eval_idx = te_idx
    log("holdout: n_train=%d n_test=%d AUC=%.3f Acc=%.3f" % (
        len(tr_idx), len(te_idx), auc, acc))
    if not (0.0 <= auc <= 1.0):
        fail("AUC 越界")
    validation_type = "internal_holdout_approximation"
    plot_label = "frozen model (AUC=%.3f)" % auc
    caption_line = "line1: frozen hold-out ROC"
    caption_count = "n_test=%d" % len(te_idx)
    metric_line = "holdout_auc=%.3f holdout_acc=%.3f" % (auc, acc)
    report_lines = [
        "validation_type=%s" % validation_type,
        "note=line1 raw_data 只有一套 bulk 数据集（GSE277173），无第二个独立 GEO 数据集；",
        "      本步骤用分层留出法做冻结评估（特征与超参在训练集确定后冻结，测试集只 predict）；",
        "      这是内部近似，非独立外部验证；真正外部 GEO 验证待补充外部数据后另跑",
        "n_train=%d n_test=%d frozen_features=%d" % (len(tr_idx), len(te_idx), len(features)),
        "frozen_model=logreg(L2,C=1)，测试集不重训、不重新筛基因",
        metric_line,
        "confusion_matrix(labels=0,1)=%s" % cm.tolist(),
        "limitation_note=样本极小（测试集 %d），AUC 置信区间极宽；仅作流程示范与方向参考" % len(te_idx),
    ]

# ROC 单图
fig, ax = plt.subplots(figsize=(6.5, 6))
fpr, tpr, _ = roc_curve(y[eval_idx], proba)
ax.plot(fpr, tpr, color="#C44E52", label=plot_label)
ax.plot([0, 1], [0, 1], "k--", lw=0.8)
ax.set_xlabel("False positive rate")
ax.set_ylabel("True positive rate")
caption(fig, caption_line, caption_count)
# 源级外置：图例置轴框外右侧（规范 §三之二，不再依赖 guard 纠正）
ax.legend(loc="upper left", bbox_to_anchor=(1.02, 1.0), frameon=False)
fig.savefig("../figures/l1_12_external_roc.png")
plt.close(fig)
log("wrote ../figures/l1_12_external_roc.png")

# 逐评估样本预测表
rows = []
for k, i in enumerate(eval_idx):
    p_val = round(float(proba[k]), 4)
    rows.append({"sample": samples[i], "true": int(y[i]), "pred": int(pred[k]),
                 "prob_LS": p_val, ("prob_" + case_group): p_val})
pd.DataFrame(rows).to_csv("external_validation_preds.tsv", sep="\t", index=False)

# 方向一致性：冻结特征在训练集上的系数方向
dir_rows = [{"gene": g, "frozen_coef": round(float(c), 4),
             "direction": ("up_in_" + case_group) if c > 0 else ("down_in_" + case_group),
             "direction_LS": "up_in_LS" if c > 0 else "down_in_LS"}
            for g, c in zip(features, coefs)]
pd.DataFrame(dir_rows).to_csv("external_frozen_coefs.tsv", sep="\t", index=False)

lines = [
    "step=external_validation",
    "seed=%d" % SEED,
] + report_lines + [
    "outputs=external_validation_preds.tsv, external_frozen_coefs.tsv, ../figures/l1_12_external_roc.png, external_validation_report.txt",
    "elapsed_seconds=%.1f" % (time.time() - START),
]
with open("external_validation_report.txt", "w", encoding="utf-8") as fh:
    fh.write("\n".join(lines) + "\n")
log("external_validation_done")
# 句柄兜底（figure_spec 第 3 节 / Argon 第 65 轮 Q3）：逐图 close(fig) 已在 save() 内执行，
# 这里再 close("all") 兜住异常分支的残留图，防单步跑多图时峰值内存叠加。
plt.close("all")
PYSCRIPT
