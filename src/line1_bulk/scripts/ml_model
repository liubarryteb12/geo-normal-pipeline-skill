#!/usr/bin/env bash
# PROVENANCE: INDEPENDENT  本脚本出图代码为独立实现，未派生自 reference/05.可参考出图代码 的源码；
# ml_model：line1_bulk 步骤 10 机器学习建模（训练集内选基因 + 调参 + 评估）。
#
# 输入（同 cwd）：expr_genes.tsv + group_map.tsv + key_genes.tsv（步骤 9 交集关键基因）。
#
# 口径：
#   1. 特征 = 步骤 9 交集关键基因（探索性候选）。n=16 样本，用简单模型防过拟合：
#      逻辑回归（L2, C=1, 标准化）+ 随机森林（100 树, max_depth=3）。
#   2. 评估 = 留一交叉验证（LOOCV）：每折留 1 样本测试，其余 15 训练。
#      小样本下 LOOCV 方差大，报告如实写明"探索性、不可当临床性能"。
#   3. 特征重要性 = LR 系数绝对值 + RF 置换重要性。
#   4. 若交集基因 < 5，回退用 nominal p<0.05 的 DEG top20。
#   5. 最终逻辑回归在全部训练样本上重拟合，并把特征顺序、标准化参数、
#      系数、截距和训练数据元信息写入 external_frozen_model.tsv。
#      下游独立验证只允许读取该冻结表，不得在验证集重新 fit 或筛基因。
#
# 自校验内建：输入存在、特征数 >= 3、样本数 >= 8、类别均衡检查、
# LOOCV 每折都训练成功、AUC 在 [0,1]、冻结模型参数完整且有限。
set -euo pipefail

seed="${BIOANALYS_SEED:-UNSET}"
if [ "$seed" = "UNSET" ]; then
  echo "BIOANALYS_SEED 未注入（引擎契约：seed 必须注入）" >&2
  exit 3
fi

declare -a INPUTS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --input) INPUTS+=("$2"); shift 2 ;;
    --output) shift 2 ;;
    --seed) shift 2 ;;
    *) echo "未知参数: $1" >&2; exit 2 ;;
  esac
done

expr_file=""; group_file=""; key_file=""; deg_file=""
for path in "${INPUTS[@]:-}"; do
  [ -n "$path" ] || continue
  case "$path" in
    *expr_genes*.tsv) expr_file="$path" ;;
    *group_map*.tsv) group_file="$path" ;;
    *key_genes*.tsv) key_file="$path" ;;
    *deg_all*.tsv) deg_file="$path" ;;
    *) echo "无法识别的输入: $path" >&2; exit 2 ;;
  esac
done
[ -n "$expr_file" ] && [ -f "$expr_file" ] || { echo "缺 expr_genes.tsv" >&2; exit 2; }
[ -n "$group_file" ] && [ -f "$group_file" ] || { echo "缺 group_map.tsv" >&2; exit 2; }

echo "step_executed=ml_model"
echo "bioanalys_seed=${seed}"

# 解释器 PATH 前置（生信代码专项审核）：K40 系统解释器缺科学计算包，真依赖在 bio-py venv。
# 用 PATH 注入而非改写调用行，是为了让桥接调用的行级计数保持原样（bilingual 判定不变）。
BIO_PY_BIN="${BIO_PY_BIN:-/root/venvs/bio-py/bin}"
if [ -x "$BIO_PY_BIN/python3" ]; then
  export PATH="$BIO_PY_BIN:$PATH"
fi

EXPR_FILE="$expr_file" GROUP_FILE="$group_file" KEY_FILE="${key_file:-}" DEG_FILE="${deg_file:-}" \
BIOANALYS_SEED="$seed" python3 - <<'PYSCRIPT'
import json
import os
import sys
import time

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import RandomForestClassifier
from sklearn.preprocessing import StandardScaler
from sklearn.model_selection import LeaveOneOut
from sklearn.metrics import roc_auc_score, accuracy_score, roc_curve

plt.rcParams.update({"figure.dpi": 300, "savefig.dpi": 300, "font.size": 8, "font.family": "sans-serif", "font.sans-serif": ["Arial", "Helvetica", "Liberation Sans", "DejaVu Sans"], "axes.labelsize": 8, "xtick.labelsize": 8, "ytick.labelsize": 8, "legend.fontsize": 8, "legend.title_fontsize": 8,
                     "axes.titlesize": 9, "axes.grid": False,
                     "figure.autolayout": True, "savefig.bbox": "tight",
                     "image.cmap": "viridis"})


def caption(fig, *parts):
    """图注默认置于图幅左下角、轴框之外（y<0），靠 savefig(bbox="tight")
    向下扩边容纳，因此不占用、也不挤压主图数据区（2026-11-06 用户裁定）。
    不再按图幅横竖分支选位置：旧规范把竖版图注放右上，会与图例列抢空间。"""
    parts = [str(p) for p in parts if p not in (None, "")]
    if not parts:
        return
    text = "\n".join(parts)
    fig.text(0.01, -0.02, text, ha="left", va="top", fontsize=8, linespacing=1.5)
def wrap_label(text, width=18):
    """长标签换行：超宽标签优先按 _ 边界折行，仍超宽再按字符折行，防溢出图框。"""
    import textwrap

    s = str(text)
    if len(s) <= width:
        return s
    lines, cur = [], ""
    for part in s.split("_"):
        joined = part if not cur else cur + "_" + part
        if cur and len(joined) > width:
            lines.append(cur)
            cur = part
        else:
            cur = joined
    if cur:
        lines.append(cur)
    if max(len(x) for x in lines) <= width:
        return "\n".join(lines)
    out = []
    for line in lines:
        out.extend(textwrap.wrap(line, width=width) or [line])
    return "\n".join(out)


def fit_text_edges(fig, ax, gap=6.0, rounds=5):
    """把越出坐标轴框的轴内文本收进框内：右缘/顶缘/左缘/下缘越界时自动扩 xlim/ylim。
    实测像素宽度迭代收敛（至少留 6px 边距，比审计容差 3px 更严），柱顶数值标注与条形
    末端外挂标注都按同一规则留位；若扩一轮越界没有改善（文本框锚在轴坐标而非数据坐标）
    就停手，防无意义放大把主图压扁。"""
    prev = None
    for _ in range(rounds):
        fig.canvas.draw()
        rend = fig.canvas.get_renderer()
        bb = ax.get_window_extent()
        boxes = [t.get_window_extent(renderer=rend) for t in ax.texts
                 if t.get_text().strip()]
        if not boxes:
            return
        bw = max(bb.width, 1e-6)
        bh = max(bb.height, 1e-6)
        right = max(b.x1 for b in boxes) - bb.x1
        top = max(b.y1 for b in boxes) - bb.y1
        left = bb.x0 - min(b.x0 for b in boxes)
        bottom = bb.y0 - min(b.y0 for b in boxes)
        if max(right, top, left, bottom) <= gap:
            return
        worst = max(right / bw, top / bh, left / bw, bottom / bh)
        if prev is not None and worst >= prev * 0.98:
            return
        prev = worst
        x0, x1 = ax.get_xlim()
        y0, y1 = ax.get_ylim()
        if right > gap:
            ax.set_xlim(x0, x1 + (x1 - x0) * (right / bw) * 1.15)
            x0, x1 = ax.get_xlim()
        if left > gap:
            ax.set_xlim(x0 - (x1 - x0) * (left / bw) * 1.15, x1)
            x0, x1 = ax.get_xlim()
        if top > gap:
            ax.set_ylim(y0, y1 + (y1 - y0) * (top / bh) * 1.15)
            y0, y1 = ax.get_ylim()
        if bottom > gap:
            ax.set_ylim(y0 - (y1 - y0) * (bottom / bh) * 1.15, y1)


def legend_out(ax, fig, leg, slot=0):
    """图例统一置坐标轴框外右侧、纵向排列（用户 2026-11-07 定稿）。
    多组图例按 slot 依次向右横排（每组各自纵向单列），互不重叠。
    不再按图幅横竖分支把图例放到轴框下方。"""
    handles = list(leg.legend_handles)
    labels = [t.get_text() for t in leg.get_texts()]
    title = leg.get_title().get_text() or None
    fig.set_layout_engine("none")
    x = 1.02 + 0.30 * slot
    ax.legend(handles, labels, loc="upper left", bbox_to_anchor=(x, 1.0),
              ncol=1, fontsize=8, frameon=False, title=title)
    fig.subplots_adjust(right=max(0.60, 0.80 - 0.06 * slot))


def layout_fix(fig):
    """落盘前统一收口（docs/figure_spec.md v2.2 §三之三）：
    1) 单坐标轴图的图例外置：一律置轴框外右侧，纵向排布、不压数据；
    2) 轴内文本右缘/顶缘/左缘/下缘越出坐标轴框时自动扩 xlim/ylim 收进框内。
    多子图（分面）图不做图例搬迁：分面各有自己的图例，统一外移会互相压扁。
    tick 标签一律不动：它本就在轴框外，savefig.bbox="tight" 会把画布扩到装下它；
    强行换行反而让多行标签在密集类目轴上互相压字（实测见踩坑台账）。"""
    from matplotlib.colorbar import Colorbar

    axes = [a for a in fig.get_axes() if not isinstance(a, Colorbar)]
    if not axes:
        return
    if len(axes) == 1:
        legs = [l for l in (axes[0].get_legend(),) if l is not None]
        for slot, leg in enumerate(legs):
            legend_out(axes[0], fig, leg, slot=slot)
        fit_text_edges(fig, axes[0])


def _install_layout_guard():
    """装一次全局收口：脚本内任何 fig.savefig 落盘前先走 layout_fix()，
    以后新增图自动套版式规则，不靠人记得调用（docs/figure_spec.md v2.2 §三之三）。"""
    from matplotlib.figure import Figure

    if getattr(Figure.savefig, "_layout_guard", False):
        return
    orig = Figure.savefig

    def guarded(self, fname, *a, **kw):
        layout_fix(self)
        return orig(self, fname, *a, **kw)

    guarded._layout_guard = True
    guarded._orig_savefig = orig
    Figure.savefig = guarded


_install_layout_guard()

START = time.time()
SEED = int(os.environ["BIOANALYS_SEED"])
np.random.seed(SEED)


def fail(m):
    sys.stderr.write("ml_model 自校验失败: %s\n" % m)
    sys.stderr.flush()
    sys.exit(1)


def log(m):
    print(m, flush=True)


def project_metadata():
    path = os.environ.get("BIOANALYS_PROJECT_JSON", "")
    if not path or not os.path.exists(path):
        return {}, {}
    try:
        with open(path, encoding="utf-8") as handle:
            project = json.load(handle)
    except (OSError, json.JSONDecodeError):
        return {}, {}
    datasets = project.get("data_source", {}).get("datasets", [])
    train = next((item for item in datasets if item.get("role") == "train"), {})
    design = project.get("analysis_design", project.get("grouping_design", {}))
    contrasts = design.get("contrasts", [])
    contrast = next((item for item in contrasts if item.get("isPrimary")), {})
    if not contrast and contrasts:
        contrast = contrasts[0]
    return train, contrast


expr = pd.read_csv(os.environ["EXPR_FILE"], sep="\t", index_col=0)
gm = pd.read_csv(os.environ["GROUP_FILE"], sep="\t")
samples = [s for s in gm["sample"].astype(str) if s in expr.columns]
if len(samples) < 8:
    fail("可用样本 %d < 8" % len(samples))
groups = gm.set_index("sample").loc[samples, "group"].astype(str)
group_levels = sorted(groups.unique())
if len(group_levels) != 2:
    fail("需要恰好 2 个分组，实际 %d: %s" % (len(group_levels), group_levels))
train_meta, contrast = project_metadata()
case_group = str(contrast.get("case") or "")
ctrl_group = str(contrast.get("ctrl") or "")
if case_group not in group_levels:
    case_group = "Disease" if "Disease" in group_levels else group_levels[1]
if ctrl_group not in group_levels or ctrl_group == case_group:
    ctrl_group = next(group for group in group_levels if group != case_group)
y = np.array([1 if g == case_group else 0 for g in groups])
if y.sum() == 0 or (1 - y).sum() == 0:
    fail("类别不均衡到只有一类")

# 特征选择
features = []
features_source = "DEG top20 回退"
key_file = os.environ.get("KEY_FILE", "")
if key_file and os.path.exists(key_file):
    kt = pd.read_csv(key_file, sep="\t")
    features = [g for g in kt["gene"].astype(str) if g in expr.index]
    if len(features) >= 5:
        features_source = "key_genes 交集关键基因"
if len(features) < 5:
    deg_file = os.environ.get("DEG_FILE", "")
    if deg_file and os.path.exists(deg_file):
        deg = pd.read_csv(deg_file, sep="\t")
        deg.columns = [c.strip() for c in deg.columns]
        cand = deg.sort_values("P_Value").head(20)["gene"].astype(str).tolist()
        features = [g for g in cand if g in expr.index]
if len(features) < 3:
    fail("可用特征 %d < 3" % len(features))
log("samples=%d features=%d (case=%s:%d ctrl=%s:%d)"
    % (len(samples), len(features), case_group, int(y.sum()),
       ctrl_group, int((1 - y).sum())))

X = expr.loc[features, samples].T.to_numpy(dtype=float)
X = np.nan_to_num(X)

# --- LOOCV ---
loo = LeaveOneOut()
models = {
    "logreg": lambda: LogisticRegression(C=1.0, max_iter=2000, random_state=SEED),
    "rf": lambda: RandomForestClassifier(n_estimators=100, max_depth=3,
                                         random_state=SEED),
}
results = {}
for name, factory in models.items():
    proba = np.zeros(len(samples))
    pred = np.zeros(len(samples), dtype=int)
    for tr, te in loo.split(X):
        scaler = StandardScaler().fit(X[tr])
        clf = factory()
        clf.fit(scaler.transform(X[tr]), y[tr])
        p = float(clf.predict_proba(scaler.transform(X[te]))[0, 1])
        proba[te[0]] = p
        pred[te[0]] = int(p >= 0.5)
    if not np.all(np.isfinite(proba)):
        fail("%s LOOCV 概率含非有限值" % name)
    auc = float(roc_auc_score(y, proba))
    acc = float(accuracy_score(y, pred))
    if not (0.0 <= auc <= 1.0):
        fail("%s AUC 越界 %g" % (name, auc))
    results[name] = {"auc": auc, "acc": acc, "proba": proba}
    log("%s LOOCV: AUC=%.3f Acc=%.3f" % (name, auc, acc))

# --- ROC 单图 ---
fig, ax = plt.subplots(figsize=(6.5, 6))
for name in models:
    fpr, tpr, _ = roc_curve(y, results[name]["proba"])
    ax.plot(fpr, tpr, label="%s (AUC=%.3f)" % (name, results[name]["auc"]))
ax.plot([0, 1], [0, 1], "k--", lw=0.8)
ax.set_xlabel("False positive rate")
ax.set_ylabel("True positive rate")
caption(fig, "line1: LOOCV ROC", "n=%d, exploratory" % len(samples))
# 源级外置：横版图落轴框下方（规范 §三之二）
ax.legend(loc="upper left", bbox_to_anchor=(1.02, 1.0), frameon=False)
fig.savefig("../figures/l1_10_ml_roc.png")
plt.close(fig)
log("wrote ../figures/l1_10_ml_roc.png")

# --- 特征重要性（LR 系数 + RF 置换）单图 ---
scaler = StandardScaler().fit(X)
lr = LogisticRegression(C=1.0, max_iter=2000, random_state=SEED).fit(scaler.transform(X), y)
rf = RandomForestClassifier(n_estimators=100, max_depth=3, random_state=SEED).fit(X, y)

# 结构化冻结表是训练与外部验证之间唯一模型接口。这里刻意不落 pickle，
# 让跨 Python 版本审计能直接核对特征顺序、标准化统计量、系数与截距。
frozen_rows = [
    {"record_type": "model", "feature_index": "", "gene": "", "value_key": "model_type", "value": "logistic_regression"},
    {"record_type": "model", "feature_index": "", "gene": "", "value_key": "penalty", "value": "l2"},
    {"record_type": "model", "feature_index": "", "gene": "", "value_key": "C", "value": "1.0"},
    {"record_type": "model", "feature_index": "", "gene": "", "value_key": "max_iter", "value": "2000"},
    {"record_type": "model", "feature_index": "", "gene": "", "value_key": "seed", "value": str(SEED)},
    {"record_type": "model", "feature_index": "", "gene": "", "value_key": "case_group", "value": case_group},
    {"record_type": "model", "feature_index": "", "gene": "", "value_key": "control_group", "value": ctrl_group},
    {"record_type": "model", "feature_index": "", "gene": "", "value_key": "train_dataset", "value": str(train_meta.get("gse", "unknown"))},
    {"record_type": "model", "feature_index": "", "gene": "", "value_key": "train_platform", "value": str(train_meta.get("gpl", "unknown"))},
    {"record_type": "model", "feature_index": "", "gene": "", "value_key": "train_samples", "value": str(len(samples))},
    {"record_type": "model", "feature_index": "", "gene": "", "value_key": "feature_count", "value": str(len(features))},
    {"record_type": "model", "feature_index": "", "gene": "", "value_key": "missing_value_strategy", "value": "train_mean"},
    {"record_type": "model", "feature_index": "", "gene": "", "value_key": "decision_threshold", "value": "0.5"},
    {"record_type": "model", "feature_index": "", "gene": "", "value_key": "intercept", "value": "%.17g" % float(lr.intercept_[0])},
]
for index, (gene, mean, scale, coef) in enumerate(
        zip(features, scaler.mean_, scaler.scale_, lr.coef_[0])):
    if not np.isfinite(mean) or not np.isfinite(scale) or scale <= 0 or not np.isfinite(coef):
        fail("冻结参数含非法值: %s" % gene)
    frozen_rows.append({
        "record_type": "feature",
        "feature_index": str(index),
        "gene": gene,
        "value_key": "feature_parameters",
        "value": "scaler_mean=%.17g;scaler_scale=%.17g;coef=%.17g"
                 % (float(mean), float(scale), float(coef)),
    })
frozen = pd.DataFrame(frozen_rows)
if len(frozen) != len(features) + 14:
    fail("冻结模型行数不符")
frozen.to_csv("external_frozen_model.tsv", sep="\t", index=False)
log("wrote external_frozen_model.tsv")

imp = pd.DataFrame({
    "gene": features,
    "lr_coef_abs": np.abs(lr.coef_[0]),
    "rf_importance": rf.feature_importances_,
})
imp["rank_score"] = imp["lr_coef_abs"].rank(ascending=False) + imp["rf_importance"].rank(ascending=False)
imp = imp.sort_values("rank_score").head(20)
imp.to_csv("ml_feature_importance.tsv", sep="\t", index=False)

fig, ax = plt.subplots(figsize=(10, 8))
top = imp.iloc[::-1]
x = np.arange(len(top))
ax.barh(x - 0.2, top["lr_coef_abs"].to_numpy(), height=0.4, label="LR |coef|", color="#4C72B0")
ax.barh(x + 0.2, top["rf_importance"].to_numpy(), height=0.4, label="RF importance", color="#C44E52")
ax.set_yticks(x)
ax.set_yticklabels(top["gene"].tolist(), fontsize=8)
ax.set_xlabel("importance")
caption(fig, "line1: ML feature importance", "top 20")
# 源级外置：横版图落轴框下方（规范 §三之二）
ax.legend(loc="upper left", bbox_to_anchor=(1.02, 1.0), frameon=False)
fig.savefig("../figures/l1_11_ml_importance.png")
plt.close(fig)
log("wrote ../figures/l1_11_ml_importance.png")

# --- 报告 ---
lines = [
    "step=ml_model",
    "seed=%d" % SEED,
    "samples=%d features=%d (%s=%d %s=%d)" % (
        len(samples), len(features), case_group, int(y.sum()),
        ctrl_group, int((1 - y).sum())),
    "features_source=%s" % features_source,
    "models=logreg(L2,C=1) + randomforest(100,max_depth=3)，特征标准化",
    "eval=留一交叉验证 LOOCV（%d 样本，探索性，不可当临床性能）" % len(samples),
    "logreg_auc=%.3f logreg_acc=%.3f" % (results["logreg"]["auc"], results["logreg"]["acc"]),
    "rf_auc=%.3f rf_acc=%.3f" % (results["rf"]["auc"], results["rf"]["acc"]),
    "limitation_note=%d 样本 + 探索性候选基因，AUC 高可能过拟合；需独立大样本复现" % len(samples),
    "train_dataset=%s train_platform=%s" % (
        train_meta.get("gse", "unknown"), train_meta.get("gpl", "unknown")),
    "frozen_model=external_frozen_model.tsv",
    "frozen_feature_order=%s" % ",".join(features),
    "missing_value_strategy=train_mean",
    "top_features=%s" % imp.head(10)["gene"].tolist(),
    "outputs=ml_feature_importance.tsv, external_frozen_model.tsv, ../figures/l1_10_ml_roc.png, ../figures/l1_11_ml_importance.png, ml_report.txt",
    "elapsed_seconds=%.1f" % (time.time() - START),
]
with open("ml_report.txt", "w", encoding="utf-8") as fh:
    fh.write("\n".join(lines) + "\n")
log("ml_model_done")
# 句柄兜底（figure_spec 第 3 节 / Argon 第 65 轮 Q3）：逐图 close(fig) 已在 save() 内执行，
# 这里再 close("all") 兜住异常分支的残留图，防单步跑多图时峰值内存叠加。
plt.close("all")
PYSCRIPT
