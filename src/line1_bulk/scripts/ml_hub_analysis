    % (len(lasso_set), summ.loc[summ["metric"] == "selection_rule", "value"].iloc[0]),
    "  b) RFE (logistic L2, 4-fold stratified AUC): n_selected=%d (optimal n_features=%d)"
    % (len(rfe_set), best_n),
    "  c) univariate Firth logistic p<%.2f: n_selected=%d" % (ALPHA, len(uni_sig)),
    "  core = %s -> %d genes" % (rule, len(core)),
    "  core_genes=%s" % ",".join(core),
    "",
    "[class-1 skipped] Cox regression:",
    "  NOT performed. Project metadata provides no sample-level survival endpoint,",
    "  so Surv(time, event) cannot be constructed and Cox regression is undefined.",
    "",
    "[class-2] importance on core hub genes (no reduction):",
    "  top by RF importance: %s"
    % ", ".join("%s=%.4f" % (r["gene"], r["rf_importance"]) for _, r in imp.head(8).iterrows()),
    "  top by GBDT importance: %s"
    % ", ".join("%s=%.4f" % (r["gene"], r["gbdt_importance"])
                for _, r in imp.sort_values("gbdt_importance", ascending=False).head(8).iterrows()),
]
if shap_ok:
    lines.append("  top by mean|SHAP|: %s"
                 % ", ".join("%s=%.4f" % (r["gene"], r["shap_mean_abs"])
                             for _, r in imp.sort_values("shap_mean_abs", ascending=False).head(8).iterrows()))
else:
    lines.append("  SHAP: skipped (computation failed)")
lines += [
    "  clustering (ward on core genes): ARI vs %s/%s=%.3f (1=perfect, 0=random)"
    % (CASE_GROUP, CONTROL_GROUP, ari),
    "  correlation network: %d edges among %d core genes" % (G.number_of_edges(), len(core)),
    "",
    "limitations:",
    "  1. n=%d (%s=%d, %s=%d)，所有 AUC/重要性/ARI 均为探索性，样本量不足以支撑临床性能声明。"
    % (len(samples), CASE_GROUP, int(y.sum()), CONTROL_GROUP, int((1 - y).sum())),
    "  2. LASSO/RFE 在当前样本量上极易过拟合；RFE 用 4 折（LOO 无法算 AUC）故曲线噪声大。",
    "  3. SHAP 基于 RF（500 树 depth3），mean|SHAP| 是相对贡献，非效应量。",
    "  4. 聚类 ARI 只反映核心基因的组间区分能力，不作分类器性能。",
    "  5. 单因素/多因素 Cox 因无生存终点未做（见 class-1 skipped）。",
    "",
    "outputs=ml_lasso_path.tsv, ml_lasso_cv.tsv, ml_lasso_genes.tsv, ml_lasso_summary.tsv,",
    "        ml_rfe_curve.tsv, ml_rfe_genes.tsv, ml_univariate.tsv, ml_core_hub_genes.tsv,",
    "        ml_importance.tsv, ml_cluster_samples.tsv, ml_corr_network.tsv,",
