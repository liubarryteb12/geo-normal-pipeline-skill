#!/usr/bin/env bash
# PROVENANCE: INDEPENDENT  本脚本出图代码为独立实现，未派生自 reference/05.可参考出图代码 的源码；
# ml_hub_analysis：line1_bulk 机器学习：hub 基因精筛 + 重要性评估（aims 线1"机器学习建模"扩展）。
#
# 两类方法（用户 2026-10-14 指定）：
#   第一类 进一步筛选 hub 基因（减少基因数量，聚焦核心）：
#     LASSO 回归（R glmnet, binomial）/ 递归特征消除 RFE / 基于统计显著性的筛选（单因素 logistic）。
#     单因素-多因素 Cox 回归：项目未提供样本级生存终点时无法构造 Surv(time, event)，报告如实跳过。
#   第二类 加强 hub 基因的重要性评估（不减少基因数量，量化贡献度）：
#     随机森林重要性 / 梯度提升树重要性 / SHAP 值 / 聚类（验证区分能力）/ 相关性网络。
#
# 输入（cwd 下）：expr_genes.tsv + group_map.tsv + key_genes.tsv（步骤 9 hub 池）；
#   若 key_genes 基因 < 8 则回退 deg_all.tsv nominal p<0.05 top50。
# 输出（cwd 下）：
#   ml_lasso_path.tsv / ml_lasso_cv.tsv / ml_lasso_genes.tsv / ml_lasso_summary.tsv
#   ml_rfe_curve.tsv / ml_rfe_genes.tsv / ml_univariate.tsv
#   ml_core_hub_genes.tsv / ml_importance.tsv / ml_shap.tsv
#   ml_cluster_samples.tsv / ml_corr_network.tsv / ml_hub_report.txt
#   ../figures/l1_16..l1_24（9 张）
#
# 口径：docs/figure_spec.md（Agg/300dpi/英文标签；图注置坐标轴框外；图例/colorbar 带 label；
#       热图行=基因列=观测；富集类双标注不适用此处）。全部结论按当前样本量标注为探索性。
set -euo pipefail

RSCRIPT_BIN="${BIOANALYS_RSCRIPT:-/mnt/ssd/bio_data/ops/layout_autoload/bin/Rscript}"

seed="${BIOANALYS_SEED:-UNSET}"
if [ "$seed" = "UNSET" ]; then
  echo "BIOANALYS_SEED 未注入（引擎契约：seed 必须注入）" >&2
  exit 3
fi

declare -a INPUTS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --input) INPUTS+=("$2"); shift 2 ;;
    --output) shift 2 ;;
    --seed) shift 2 ;;
    *) echo "未知参数: $1" >&2; exit 2 ;;
  esac
done

expr_file=""; group_file=""; key_file=""; deg_file=""
for path in "${INPUTS[@]:-}"; do
  [ -n "$path" ] || continue
  case "$path" in
    *expr_genes*.tsv) expr_file="$path" ;;
    *group_map*.tsv) group_file="$path" ;;
    *key_genes*.tsv) key_file="$path" ;;
    *deg_all*.tsv) deg_file="$path" ;;
    *) echo "无法识别的输入: $path" >&2; exit 2 ;;
  esac
done
# 未显式传 --input 时回退 cwd 固定文件名（引擎传绝对路径，手工试跑用 cwd）
expr_file="${expr_file:-expr_genes.tsv}"
group_file="${group_file:-group_map.tsv}"
key_file="${key_file:-key_genes.tsv}"
deg_file="${deg_file:-deg_all.tsv}"
[ -n "$expr_file" ] && [ -f "$expr_file" ] || { echo "缺 expr_genes.tsv" >&2; exit 2; }
[ -n "$group_file" ] && [ -f "$group_file" ] || { echo "缺 group_map.tsv" >&2; exit 2; }
[ -n "$key_file" ] && [ -f "$key_file" ] || { echo "缺 key_genes.tsv" >&2; exit 2; }

echo "step_executed=ml_hub_analysis"
echo "bioanalys_seed=${seed}"

# ---------- 1) 定 hub 池（python）：key_genes 交集关键基因，不足 8 则回退 DEG nominal ----------
# 解释器 PATH 前置（生信代码专项审核）：K40 系统解释器缺科学计算包，真依赖在 bio-py venv。
# 用 PATH 注入而非改写调用行，是为了让桥接调用的行级计数保持原样（bilingual 判定不变）。
BIO_PY_BIN="${BIO_PY_BIN:-/root/venvs/bio-py/bin}"
if [ -x "$BIO_PY_BIN/python3" ]; then
  export PATH="$BIO_PY_BIN:$PATH"
fi

EXPR_FILE="$expr_file" GROUP_FILE="$group_file" KEY_FILE="$key_file" DEG_FILE="${deg_file:-}" \
BIOANALYS_SEED="$seed" python3 - <<'PYSCRIPT'
import json
import os
import sys

import pandas as pd

NOMINAL_P = 0.05
FALLBACK_TOP = 50
MIN_POOL = 8


def fail(m):
    sys.stderr.write("ml_hub_analysis(pool) 自校验失败: %s\n" % m)
    sys.stderr.flush()
    sys.exit(1)


def resolve_groups(group_file):
    group_map = pd.read_csv(group_file, sep="\t")
    if "sample" not in group_map.columns or "group" not in group_map.columns:
        fail("group_map 缺 sample/group 列")
    observed = list(dict.fromkeys(group_map["group"].astype(str)))
    case_group = ""
    control_group = ""
    project_path = os.environ.get("BIOANALYS_PROJECT_JSON", "")
    if project_path and os.path.exists(project_path):
        try:
            with open(project_path, encoding="utf-8") as handle:
                project = json.load(handle)
        except (OSError, json.JSONDecodeError):
            project = {}
        contrasts = project.get("grouping_design", {}).get("contrasts", [])
        primary = next(
            (item for item in contrasts if item.get("isPrimary") is True),
            contrasts[0] if contrasts else {},
        )
        case_group = str(primary.get("case", "")).strip()
        control_group = str(primary.get("ctrl", "")).strip()
    if not case_group and "Disease" in observed and "Normal" in observed:
        case_group, control_group = "Disease", "Normal"
    if case_group not in observed or control_group not in observed:
        fail(
            "无法从 project.json 主对照解析 group_map 分组: case=%r control=%r observed=%s"
            % (case_group, control_group, observed)
        )
    if case_group == control_group:
        fail("case 与 control 不能相同")
    return case_group, control_group


expr = pd.read_csv(os.environ["EXPR_FILE"], sep="\t", index_col=0)
key = pd.read_csv(os.environ["KEY_FILE"], sep="\t")
if "gene" not in key.columns:
    fail("key_genes 缺 gene 列")
case_group, control_group = resolve_groups(os.environ["GROUP_FILE"])
pool = [g for g in key["gene"].astype(str) if g in expr.index]
source = "key_genes 交集关键基因"

deg_file = os.environ.get("DEG_FILE", "")
if len(pool) < MIN_POOL and deg_file and os.path.exists(deg_file):
    deg = pd.read_csv(deg_file, sep="\t")
    deg.columns = [c.strip() for c in deg.columns]
    cand = deg.loc[deg["P_Value"] < NOMINAL_P].sort_values("P_Value").head(FALLBACK_TOP)
    pool = [g for g in cand["gene"].astype(str) if g in expr.index]
    source = "deg_all nominal p<0.05 top%d 回退" % FALLBACK_TOP
if len(pool) < MIN_POOL:
    fail("hub 池基因 %d < %d，无法做 LASSO/RFE" % (len(pool), MIN_POOL))

pd.DataFrame({"gene": pool}).to_csv("_ml_pool.tsv", sep="\t", index=False)
pd.DataFrame(
    {"role": ["case", "control"], "group": [case_group, control_group]}
).to_csv("_ml_groups.tsv", sep="\t", index=False)
print("hub pool=%d (%s)" % (len(pool), source), flush=True)
print("groups case=%s control=%s" % (case_group, control_group), flush=True)
PYSCRIPT

# ---------- 跨语言桥接守卫（task-10）：本母版为 Python 到 R 的跨语言步骤，断言先于首次 R 侧执行 ----------
# 输入为 tsv 家族（无 h5ad/rds）时守卫自行 [BRIDGE SKIP] 放行，语义由守卫判定。
ml_hub_bridge_input=""
for _in in "${INPUTS[@]:-}"; do
  case "$_in" in
    *.h5ad|*.rds) ml_hub_bridge_input="$_in"; break ;;
  esac
done
if [ -n "$ml_hub_bridge_input" ]; then
  "$(dirname "$0")/../../bridge_guard.sh" --input "$ml_hub_bridge_input" --from Python --to R --script ml_hub_analysis || exit $?
fi

# ---------- 2) 第一类-LASSO（R glmnet）：系数路径 + 交叉验证 + 选中基因 ----------
EXPR_FILE="$expr_file" GROUP_FILE="$group_file" BIOANALYS_SEED="$seed" \
"$RSCRIPT_BIN" - <<'RSCRIPT'
suppressMessages(library(glmnet))
fail <- function(msg) { cat("ml_hub_analysis(R) 自校验失败:", msg, "\n", file = stderr()); quit(status = 1) }
say <- function(...) cat(..., "\n")

seed <- as.integer(Sys.getenv("BIOANALYS_SEED"))
set.seed(seed)

expr <- read.delim(Sys.getenv("EXPR_FILE"), check.names = FALSE, row.names = 1)
gm <- read.delim(Sys.getenv("GROUP_FILE"), check.names = FALSE)
groups_meta <- read.delim("_ml_groups.tsv", check.names = FALSE)
case_group <- as.character(groups_meta$group[groups_meta$role == "case"])
if (length(case_group) != 1L || !nzchar(case_group)) fail("_ml_groups.tsv 缺唯一 case 分组")
samples <- intersect(as.character(gm$sample), colnames(expr))
if (length(samples) < 8) fail(paste("可用样本", length(samples), "< 8"))
grp <- as.character(gm$group[match(samples, as.character(gm$sample))])
y <- ifelse(grp == case_group, 1L, 0L)
if (length(unique(y)) < 2) fail("结局只有一类，LASSO 无意义")

pool <- as.character(read.delim("_ml_pool.tsv", check.names = FALSE)$gene)
pool <- intersect(pool, rownames(expr))
if (length(pool) < 8) fail(paste("hub 池基因", length(pool), "< 8"))
say("LASSO input:", length(samples), "samples x", length(pool), "genes")

x <- t(as.matrix(expr[pool, samples, drop = FALSE]))
x <- matrix(as.numeric(x), nrow = nrow(x), dimnames = dimnames(x))
if (any(!is.finite(x))) fail("表达矩阵含非有限值")

fit <- glmnet(x, y, family = "binomial", alpha = 1, standardize = TRUE)
beta <- as.matrix(fit$beta)
lam <- fit$lambda

path_rows <- do.call(rbind, lapply(seq_along(lam), function(j) {
  data.frame(gene = rownames(beta), lambda = lam[j], log_lambda = log(lam[j]),
             coef = beta[, j], stringsAsFactors = FALSE)
}))
write.table(path_rows, "ml_lasso_path.tsv", sep = "\t", quote = FALSE, row.names = FALSE)
say("wrote ml_lasso_path.tsv", nrow(path_rows), "rows")

# CV：最多 8 折；失败回退 LOO。grouped=FALSE 避免小折次分组约束
nf <- min(8L, length(samples) - 1L)
cv <- tryCatch(
  cv.glmnet(x, y, family = "binomial", alpha = 1, type.measure = "deviance",
            nfolds = nf, grouped = FALSE, standardize = TRUE),
  error = function(e) {
    say("nfolds =", nf, "失败，回退 LOO:", conditionMessage(e))
    cv.glmnet(x, y, family = "binomial", alpha = 1, type.measure = "deviance",
              nfolds = length(samples), grouped = FALSE, standardize = TRUE)
  })
write.table(data.frame(lambda = cv$lambda, log_lambda = log(cv$lambda),
                       cvm = cv$cvm, cvsd = cv$cvsd, nzero = cv$nzero),
            "ml_lasso_cv.tsv", sep = "\t", quote = FALSE, row.names = FALSE)

pick <- function(s) {
  cm <- as.matrix(coef(cv, s = s))
  setdiff(rownames(cm)[cm[, 1] != 0], "(Intercept)")
}
genes_min <- pick("lambda.min")
genes_1se <- pick("lambda.1se")
if (length(genes_min) > 0) {
  chosen <- genes_min; rule <- "lambda.min"; s_use <- "lambda.min"
} else if (length(genes_1se) > 0) {
  chosen <- genes_1se; rule <- "lambda.1se"; s_use <- "lambda.1se"
} else {
  cm <- as.matrix(coef(cv, s = "lambda.min"))
  cm <- cm[rownames(cm) != "(Intercept)", , drop = FALSE]
  ord <- order(abs(cm[, 1]), decreasing = TRUE)
  chosen <- rownames(cm)[ord][seq_len(min(10, length(ord)))]
  rule <- "top10_abscoef_at_lambda.min"; s_use <- "lambda.min"
}
cm <- as.matrix(coef(cv, s = s_use))
lasso_out <- data.frame(gene = chosen, coef = as.numeric(cm[chosen, 1]),
                        stringsAsFactors = FALSE)
lasso_out <- lasso_out[order(-abs(lasso_out$coef)), ]
write.table(lasso_out, "ml_lasso_genes.tsv", sep = "\t", quote = FALSE, row.names = FALSE)

idx_min <- which.min(abs(cv$lambda - cv$lambda.min))
idx_1se <- which.min(abs(cv$lambda - cv$lambda.1se))
write.table(data.frame(
  metric = c("lambda.min", "lambda.1se", "nzero.lambda.min", "nzero.lambda.1se",
             "n_selected", "selection_rule", "nfolds"),
  value = c(sprintf("%.6g", cv$lambda.min), sprintf("%.6g", cv$lambda.1se),
            cv$nzero[idx_min], cv$nzero[idx_1se], length(chosen), rule, nf)),
  "ml_lasso_summary.tsv", sep = "\t", quote = FALSE, row.names = FALSE)
say("LASSO selected:", length(chosen), "genes (rule:", rule, ")")
RSCRIPT

# ---------- 3) 其余筛选 + 两类重要性评估 + 出图 + 报告（python） ----------
EXPR_FILE="$expr_file" GROUP_FILE="$group_file" BIOANALYS_SEED="$seed" python3 - <<'PYSCRIPT'
import os
import sys
import time

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
from matplotlib.patches import Patch
from matplotlib.colors import ListedColormap, Normalize
import numpy as np
import pandas as pd
import networkx as nx
from scipy.cluster.hierarchy import linkage, dendrogram, fcluster
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier
from sklearn.feature_selection import RFECV
from sklearn.model_selection import StratifiedKFold
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import adjusted_rand_score

plt.rcParams.update({
    "figure.dpi": 300, "savefig.dpi": 300, "font.size": 8, "font.family": "sans-serif", "font.sans-serif": ["Arial", "Helvetica", "Liberation Sans", "DejaVu Sans"], "axes.labelsize": 8, "xtick.labelsize": 8, "ytick.labelsize": 8, "legend.fontsize": 8, "legend.title_fontsize": 8,
    "axes.titlesize": 9, "axes.grid": False,
    "figure.autolayout": True, "savefig.bbox": "tight",
    "image.cmap": "viridis",
})

START = time.time()
SEED = int(os.environ["BIOANALYS_SEED"])
np.random.seed(SEED)
ALPHA = 0.05
FIGDIR = os.path.join("..", "figures")
POS = "#C44E52"
NEG = "#4C72B0"


def fail(m):
    sys.stderr.write("ml_hub_analysis(fig) 自校验失败: %s\n" % m)
    sys.stderr.flush()
    sys.exit(1)


def log(m):
    print(m, flush=True)


def caption(fig, *parts):
    """图注默认置于图幅左下角、轴框之外（y<0），靠 savefig(bbox="tight")
    向下扩边容纳，因此不占用、也不挤压主图数据区（2026-11-06 用户裁定）。
    不再按图幅横竖分支选位置：旧规范把竖版图注放右上，会与图例列抢空间。"""
    parts = [str(p) for p in parts if p not in (None, "")]
    if not parts:
        return
    text = "\n".join(parts)
    fig.text(0.01, -0.02, text, ha="left", va="top", fontsize=8, linespacing=1.5)
def wrap_label(text, width=18):
    """长标签换行：超宽标签优先按 _ 边界折行，仍超宽再按字符折行，防溢出图框。"""
    import textwrap

    s = str(text)
    if len(s) <= width:
        return s
    lines, cur = [], ""
    for part in s.split("_"):
        joined = part if not cur else cur + "_" + part
        if cur and len(joined) > width:
            lines.append(cur)
            cur = part
        else:
            cur = joined
    if cur:
        lines.append(cur)
    if max(len(x) for x in lines) <= width:
        return "\n".join(lines)
    out = []
    for line in lines:
        out.extend(textwrap.wrap(line, width=width) or [line])
    return "\n".join(out)


def fit_text_edges(fig, ax, gap=6.0, rounds=5):
    """把越出坐标轴框的轴内文本收进框内：右缘/顶缘/左缘/下缘越界时自动扩 xlim/ylim。
    实测像素宽度迭代收敛（至少留 6px 边距，比审计容差 3px 更严），柱顶数值标注与条形
    末端外挂标注都按同一规则留位；若扩一轮越界没有改善（文本框锚在轴坐标而非数据坐标）
    就停手，防无意义放大把主图压扁。"""
    prev = None
    for _ in range(rounds):
        fig.canvas.draw()
        rend = fig.canvas.get_renderer()
        bb = ax.get_window_extent()
        boxes = [t.get_window_extent(renderer=rend) for t in ax.texts
                 if t.get_text().strip()]
        if not boxes:
            return
        bw = max(bb.width, 1e-6)
        bh = max(bb.height, 1e-6)
        right = max(b.x1 for b in boxes) - bb.x1
        top = max(b.y1 for b in boxes) - bb.y1
        left = bb.x0 - min(b.x0 for b in boxes)
        bottom = bb.y0 - min(b.y0 for b in boxes)
        if max(right, top, left, bottom) <= gap:
            return
        worst = max(right / bw, top / bh, left / bw, bottom / bh)
        if prev is not None and worst >= prev * 0.98:
            return
        prev = worst
        x0, x1 = ax.get_xlim()
        y0, y1 = ax.get_ylim()
        if right > gap:
            ax.set_xlim(x0, x1 + (x1 - x0) * (right / bw) * 1.15)
            x0, x1 = ax.get_xlim()
        if left > gap:
            ax.set_xlim(x0 - (x1 - x0) * (left / bw) * 1.15, x1)
            x0, x1 = ax.get_xlim()
        if top > gap:
            ax.set_ylim(y0, y1 + (y1 - y0) * (top / bh) * 1.15)
            y0, y1 = ax.get_ylim()
        if bottom > gap:
            ax.set_ylim(y0 - (y1 - y0) * (bottom / bh) * 1.15, y1)


def legend_out(ax, fig, leg, slot=0):
    """图例统一置坐标轴框外右侧、纵向排列（用户 2026-11-07 定稿）。
    多组图例按 slot 依次向右横排（每组各自纵向单列），互不重叠。
    所有图幅方向统一放到轴框外右侧。"""
    handles = list(leg.legend_handles)
    labels = [t.get_text() for t in leg.get_texts()]
    title = leg.get_title().get_text() or None
    fig.set_layout_engine("none")
    x = 1.02 + 0.30 * slot
    ax.legend(handles, labels, loc="upper left", bbox_to_anchor=(x, 1.0),
              ncol=1, fontsize=8, frameon=False, title=title)
    fig.subplots_adjust(right=max(0.60, 0.80 - 0.06 * slot))


def layout_fix(fig):
    """落盘前统一收口（docs/figure_spec.md v2.2 §三之三）：
    1) 单坐标轴图的图例外置：一律置轴框外右侧，纵向排布、不压数据；
    2) 轴内文本右缘/顶缘/左缘/下缘越出坐标轴框时自动扩 xlim/ylim 收进框内。
    多子图（分面）图不做图例搬迁：分面各有自己的图例，统一外移会互相压扁。
    tick 标签一律不动：它本就在轴框外，savefig.bbox="tight" 会把画布扩到装下它；
    强行换行反而让多行标签在密集类目轴上互相压字（实测见踩坑台账）。"""
    from matplotlib.colorbar import Colorbar

    axes = [a for a in fig.get_axes() if not isinstance(a, Colorbar)]
    if not axes:
        return
    if len(axes) == 1:
        legs = [l for l in (axes[0].get_legend(),) if l is not None]
        for slot, leg in enumerate(legs):
            legend_out(axes[0], fig, leg, slot=slot)
        fit_text_edges(fig, axes[0])


def _install_layout_guard():
    """装一次全局收口：脚本内任何 fig.savefig 落盘前先走 layout_fix()，
    以后新增图自动套版式规则，不靠人记得调用（docs/figure_spec.md v2.2 §三之三）。"""
    from matplotlib.figure import Figure

    if getattr(Figure.savefig, "_layout_guard", False):
        return
    orig = Figure.savefig

    def guarded(self, fname, *a, **kw):
        layout_fix(self)
        return orig(self, fname, *a, **kw)

    guarded._layout_guard = True
    guarded._orig_savefig = orig
    Figure.savefig = guarded


_install_layout_guard()


expr = pd.read_csv(os.environ["EXPR_FILE"], sep="\t", index_col=0)
gm = pd.read_csv(os.environ["GROUP_FILE"], sep="\t")
groups_meta = pd.read_csv("_ml_groups.tsv", sep="\t")
CASE_GROUP = str(groups_meta.loc[groups_meta["role"] == "case", "group"].iloc[0])
CONTROL_GROUP = str(groups_meta.loc[groups_meta["role"] == "control", "group"].iloc[0])
samples = [s for s in gm["sample"].astype(str) if s in expr.columns]
group_values = gm.set_index("sample").loc[samples, "group"].astype(str)
y = np.array([1 if g == CASE_GROUP else 0 for g in group_values])
pool = [g for g in pd.read_csv("_ml_pool.tsv", sep="\t")["gene"].astype(str)
        if g in expr.index]
if len(pool) < 8:
    fail("hub 池基因 %d < 8" % len(pool))
Xall = np.nan_to_num(expr.loc[pool, samples].T.to_numpy(dtype=float))
log("samples=%d pool=%d (%s=%d %s=%d)"
    % (len(samples), len(pool), CASE_GROUP, int(y.sum()),
       CONTROL_GROUP, int((1 - y).sum())))

# ================= 第一类：hub 基因筛选 =================
# (a) LASSO（来自 R 步骤）
lasso = pd.read_csv("ml_lasso_genes.tsv", sep="\t")
lasso_set = set(lasso["gene"].astype(str))
log("LASSO selected=%d" % len(lasso_set))

# (b) RFE（递归特征消除，StratifiedKFold 4 折保 AUC 可算）
cv_rfe = StratifiedKFold(n_splits=4, shuffle=True, random_state=SEED)
rfecv = RFECV(
    estimator=LogisticRegression(C=1.0, max_iter=5000, random_state=SEED),
    step=1, cv=cv_rfe, scoring="roc_auc", min_features_to_select=2, n_jobs=1)
rfecv.fit(Xall, y)
rfe_genes = [g for g, keep in zip(pool, rfecv.support_) if keep]
rfe_set = set(rfe_genes)
curve = pd.DataFrame({
    "n_features": rfecv.cv_results_["n_features"],
    "mean_auc": rfecv.cv_results_["mean_test_score"],
    "std_auc": rfecv.cv_results_["std_test_score"],
}).sort_values("n_features")
curve.to_csv("ml_rfe_curve.tsv", sep="\t", index=False)
pd.DataFrame({"gene": rfe_genes}).to_csv("ml_rfe_genes.tsv", sep="\t", index=False)
log("RFE selected=%d (optimal n_features=%d)" % (len(rfe_genes), rfecv.n_features_))

# (c) 基于统计显著性的筛选：逐基因单因素 logistic（Firth 惩罚似然）。
# 为什么不用普通 MLE：本数据集 hub 池里大量基因完全分离（完美预测组别），
# Wald SE 发散、p 值全部退化为 ~1（2026-11-08 实测 50/50 基因 p>0.99，
# 与 limma/OLS 侧 e-16 级 p 值矛盾，见 ml_univariate.tsv 旧行）。
# Firth（Jeffreys 先验惩罚）在分离下仍收敛，是小样本 logistic 的推荐方法
#（与 R logistf 同口径）；p 值用惩罚似然比检验（LRT）。
def _firth_fit(X, y, max_iter=200, tol=1e-8):
    """Firth 惩罚 logistic IRLS。返回 (beta, info_inv, converged) 或 None。"""
    X = np.asarray(X, dtype=float)
    y = np.asarray(y, dtype=float)
    beta = np.zeros(X.shape[1])
    converged = False
    for _ in range(max_iter):
        eta = np.clip(X @ beta, -30.0, 30.0)
        mu = 1.0 / (1.0 + np.exp(-eta))
        w = np.clip(mu * (1.0 - mu), 1e-10, None)
        info = X.T @ (X * w[:, None]) + 1e-10 * np.eye(X.shape[1])
        try:
            info_inv = np.linalg.inv(info)
        except np.linalg.LinAlgError:
            return None
        sw = np.sqrt(w)
        Xs = X * sw[:, None]
        h = np.clip(np.diag(Xs @ info_inv @ Xs.T), 0.0, 1.0)
        score = X.T @ (y - mu + h * (0.5 - mu))
        step = info_inv @ score
        beta = beta + step
        if np.max(np.abs(step)) < tol:
            converged = True
            break
    if not converged or not np.all(np.isfinite(beta)):
        return None
    return beta, info_inv, converged


def _firth_loglik(X, y, beta):
    """Firth 修正对数似然：loglik + 0.5*log|I(beta)|（logistf 同口径）。"""
    eta = np.clip(X @ beta, -30.0, 30.0)
    mu = 1.0 / (1.0 + np.exp(-eta))
    w = np.clip(mu * (1.0 - mu), 1e-10, None)
    info = X.T @ (X * w[:, None]) + 1e-10 * np.eye(X.shape[1])
    sign, logdet = np.linalg.slogdet(info)
    if sign <= 0:
        return -np.inf
    ll = float(np.sum(y * np.log(mu + 1e-300)
                      + (1 - y) * np.log(1 - mu + 1e-300)))
    return ll + 0.5 * logdet


def firth_univariate(xv, y):
    """单基因 Firth logistic。返回参数 dict；常数列或拟合失败返回 None。"""
    x = np.asarray(xv, dtype=float)
    if np.ptp(x) <= 0:
        return None
    X = np.column_stack([np.ones_like(x), x])
    fit = _firth_fit(X, y)
    if fit is None:
        return None
    beta, info_inv, _converged = fit
    b = float(beta[1])
    se = float(np.sqrt(max(float(info_inv[1, 1]), 0.0)))
    X0 = X[:, [0]]
    fit0 = _firth_fit(X0, y)
    if fit0 is None:
        return None
    ll_full = _firth_loglik(X, y, beta)
    ll_null = _firth_loglik(X0, y, fit0[0])
    lrt = max(2.0 * (ll_full - ll_null), 0.0)
    from scipy.stats import chi2 as _chi2
    z = 1.959963984540054
    return {"coef": b,
            "odds_ratio": float(np.exp(np.clip(b, -500.0, 500.0))),
            "or_low95": float(np.exp(np.clip(b - z * se, -500.0, 500.0))),
            "or_high95": float(np.exp(np.clip(b + z * se, -500.0, 500.0))),
            "p_value": float(_chi2.sf(lrt, df=1))}


uni_rows = []
for g in pool:
    res = firth_univariate(Xall[:, pool.index(g)], y)
    if res is None:
        uni_rows.append({"gene": g, "coef": np.nan, "odds_ratio": np.nan,
                         "or_low95": np.nan, "or_high95": np.nan,
                         "p_value": np.nan, "method": "firth_failed"})
    else:
        uni_rows.append({"gene": g, **res, "method": "firth_lrt"})
uni = pd.DataFrame(uni_rows)
uni["p_value"] = uni["p_value"].fillna(1.0)
uni.to_csv("ml_univariate.tsv", sep="\t", index=False)
uni_sig = set(uni.loc[uni["p_value"] < ALPHA, "gene"])
log("univariate Firth logistic p<%.2f: %d genes" % (ALPHA, len(uni_sig)))

# 交集 → 核心 hub 基因（带兜底，报告写明用了哪条规则）
core = lasso_set & rfe_set & uni_sig
rule = "LASSO & RFE & univariate(p<0.05)"
if len(core) < 3:
    core = (lasso_set | rfe_set) & uni_sig
    rule = "(LASSO | RFE) & univariate(p<0.05)"
if len(core) < 3:
    core = lasso_set | rfe_set
    rule = "LASSO | RFE"
if len(core) < 2:
    core = set(uni.sort_values("p_value").head(5)["gene"])
    rule = "univariate top5"
core = [g for g in pool if g in core]
log("core hub genes=%d (rule: %s)" % (len(core), rule))

# ================= 第二类：核心 hub 基因重要性评估 =================
Xc = np.nan_to_num(expr.loc[core, samples].T.to_numpy(dtype=float))
rf = RandomForestClassifier(n_estimators=500, max_depth=3, random_state=SEED).fit(Xc, y)
gb = GradientBoostingClassifier(n_estimators=200, max_depth=2, learning_rate=0.05,
                                random_state=SEED).fit(Xc, y)
rf_imp = rf.feature_importances_
gb_imp = gb.feature_importances_

shap_ok = True
try:
    import shap
    expl = shap.TreeExplainer(rf)
    sv = expl.shap_values(Xc)
    if isinstance(sv, list):
        sv = sv[1]
    sv = np.asarray(sv)
    if sv.ndim == 3:
        sv = sv[..., 1]
    if sv.shape != Xc.shape:
        sv = np.asarray(expl(Xc).values)
        if sv.ndim == 3:
            sv = sv[..., 1]
    shap_imp = np.abs(sv).mean(axis=0)
    if shap_imp.shape[0] != len(core):
        shap_ok = False
except Exception as e:
    log("SHAP 计算失败，跳过 SHAP 图：%s" % str(e)[:120])
    shap_ok = False
    shap_imp = np.full(len(core), np.nan)

imp = pd.DataFrame({
    "gene": core, "rf_importance": rf_imp, "gbdt_importance": gb_imp,
    "shap_mean_abs": shap_imp,
})
imp["importance_rank"] = imp["rf_importance"].rank(ascending=False).astype(int)
imp = imp.sort_values("rf_importance", ascending=False)
imp.to_csv("ml_importance.tsv", sep="\t", index=False)
if shap_ok:
    imp[["gene", "shap_mean_abs"]].to_csv("ml_shap.tsv", sep="\t", index=False)

# 聚类：核心 hub 基因 z-score 后对样本层次聚类，看是否区分 case/control
Z = (Xc - Xc.mean(axis=0)) / (Xc.std(axis=0) + 1e-12)
link = linkage(Z, method="ward")
clusters = fcluster(link, t=2, criterion="maxclust")
ari = float(adjusted_rand_score(y, clusters))
pd.DataFrame({"sample": samples,
              "group": np.where(y == 1, CASE_GROUP, CONTROL_GROUP),
              "cluster": clusters}).to_csv("ml_cluster_samples.tsv", sep="\t", index=False)
log("sample clustering ARI vs group=%.3f" % ari)

# 相关性网络：核心 hub 基因 Spearman
corr = pd.DataFrame(Xc, columns=core).corr(method="spearman")
edges = []
for i in range(len(core)):
    for j in range(i + 1, len(core)):
        edges.append({"source": core[i], "target": core[j], "spearman_r": float(corr.iloc[i, j])})
edf = pd.DataFrame(edges)
edf["abs_r"] = edf["spearman_r"].abs()
sel = edf[edf["abs_r"] >= 0.5]
if len(sel) < 3:
    sel = edf.sort_values("abs_r", ascending=False).head(min(10, len(edf)))
else:
    sel = sel.sort_values("abs_r", ascending=False).head(60)
sel = sel.drop(columns=["abs_r"])
sel.to_csv("ml_corr_network.tsv", sep="\t", index=False)
log("correlation network edges=%d (of %d pairs)" % (len(sel), len(edf)))

# 核心基因明细
detail = pd.DataFrame({"gene": core})
detail["in_lasso"] = detail["gene"].isin(lasso_set)
detail["in_rfe"] = detail["gene"].isin(rfe_set)
detail["in_univariate_sig"] = detail["gene"].isin(uni_sig)
detail = detail.merge(uni[["gene", "odds_ratio", "p_value"]], on="gene", how="left")
detail = detail.merge(imp, on="gene", how="left")
detail.to_csv("ml_core_hub_genes.tsv", sep="\t", index=False)

