caption(fig, "line1: core hub gene importance (class-2 methods)",
        "RF (500 trees, depth 3) + GBDT (200 stumps) on %d core genes" % len(core),
        "n=%d samples, top %d shown; labels = importance values" % (len(samples), len(topi)))
fig.subplots_adjust(left=0.14, right=0.82, top=0.96, bottom=0.10)
fig.savefig(os.path.join(FIGDIR, "l1_21_importance.png"))
plt.close(fig)
plt.rcParams["figure.autolayout"] = True
log("wrote l1_21_importance.png")

# l1_22 SHAP
if shap_ok:
    tops = imp.sort_values("shap_mean_abs", ascending=False).head(min(20, len(imp))).iloc[::-1]
    plt.rcParams["figure.autolayout"] = False
    fig, ax = plt.subplots(figsize=(9, max(4.5, len(tops) * 0.38)))
    yv = np.arange(len(tops))
    ax.barh(yv, tops["shap_mean_abs"], color="#55A868", height=0.7)
    ax.set_yticks(yv)
    ax.set_yticklabels(tops["gene"], fontsize=8)
    ax.set_xlabel("mean |SHAP value|")
    for i, v in enumerate(tops["shap_mean_abs"]):
        ax.text(v, i, " %.4f" % v, va="center", ha="left", fontsize=8)
    caption(fig, "line1: SHAP feature importance (TreeExplainer on RF)",
            "mean absolute SHAP value across %d samples" % len(samples),
            "core hub genes only (n=%d)" % len(core))
    fig.subplots_adjust(left=0.16, right=0.82, top=0.96, bottom=0.11)
    fig.savefig(os.path.join(FIGDIR, "l1_22_shap.png"))
    plt.close(fig)
    plt.rcParams["figure.autolayout"] = True
    log("wrote l1_22_shap.png")

    # l1_26 SHAP 瀑布图：对 SHAP 预测贡献最大的样本做单样本分解
    # （f(x) = base value + sum(SHAP)，红=推向 case，蓝=推向 control，展示每个基因的具体贡献）
    try:
        # 选 SHAP 绝对值总和最大的样本（模型最确信的预测）
        contrib = sv if sv.shape == Xc.shape else None
        if contrib is not None:
            sample_idx = int(np.abs(contrib).sum(axis=1).argmax())
            row = contrib[sample_idx]
            order_w = np.argsort(np.abs(row))[::-1]
            base_val = getattr(expl, "expected_value", 0.0)
            # shap 0.53 的 expected_value 是 per-class ndarray（二分类 [p0, p1]），取 case 类
            if isinstance(base_val, (list, tuple, np.ndarray)):
                arr = np.asarray(base_val).ravel()
                base_val = float(arr[-1]) if arr.size else 0.0
            else:
                base_val = float(base_val)
            # 瀑布累积
            fig, ax = plt.subplots(figsize=(10.5, max(5, (len(order_w) + 1) * 0.42)))
            RED_W = "#B2182B"   # 正贡献 → case
            BLUE_W = "#2166AC"  # 负贡献 → control
            cum = base_val
            ypos = list(range(len(order_w)))[::-1]
            # base 条
            ax.barh(len(order_w), max(base_val, 0), color="#BDBDBD", height=0.62,
                    edgecolor="#666666", linewidth=0.5)
            ax.text(max(base_val, 0), len(order_w), "  E[f(X)]=%.3f" % base_val,
                    va="center", ha="left", fontsize=8)
            prev = cum
            for k, gi in enumerate(order_w):
                val = float(row[gi])
                color = RED_W if val >= 0 else BLUE_W
                left = min(prev, prev + val)
                ax.barh(ypos[k], abs(val), left=left, color=color, height=0.62,
                        edgecolor="#333333", linewidth=0.4)
                # 连接线
                if k < len(order_w) - 1:
                    ax.plot([prev + val, prev + val],
                            [ypos[k] - 0.31, ypos[k + 1] + 0.31], color="#888888",
                            lw=0.7, ls=":")
                ax.text(left + abs(val) + 0.01 * max(abs(row).max(), 1e-9), ypos[k],
                        "%s %+0.3f" % (wrap_label(core[gi]), val),
                        va="center", ha="left", fontsize=8,
                        color=(RED_W if val >= 0 else BLUE_W))
                prev += val
            ax.axvline(0, color="k", lw=0.6)
            ax.text(prev, -0.8, "f(X)=%.3f" % prev, va="center", ha="left",
                    fontsize=8, fontweight="bold")
            # y 标签：从上到下基因（按 |SHAP| 降序），底部 base value
            ax.set_yticks(list(ypos) + [len(order_w)])
            ax.set_yticklabels([core[gi] for gi in order_w] + ["base value"], fontsize=8)
            ax.set_xlabel(
                "SHAP value (log-odds contribution to %s prediction)" % CASE_GROUP
            )
            # x 轴右界按"最右条形 + 标注文字宽度"留位：
            # 原来用数据自适应范围，右侧标注（E[f(X)]=0.506 / FGR -0.098）会被裁掉一半。
            right_edge = max([base_val] + [min(prev, prev + float(row[gi])) + abs(float(row[gi]))
                                           for gi in order_w] + [0.0])
            span_x = max(right_edge, 1e-9)
            ax.set_xlim(min(0.0, span_x * -0.02), right_edge + 0.55 * span_x)
            # 图例外置到轴框右侧（figure_spec v2.2：禁止轴内 loc）
            ax.legend(handles=[Patch(color=RED_W, label="pushes toward %s (SHAP>0)" % CASE_GROUP),
                               Patch(color=BLUE_W, label="pushes toward %s (SHAP<0)" % CONTROL_GROUP),
                               Patch(color="#BDBDBD", label="base value E[f(X)]")],
                      fontsize=8, loc="upper left", bbox_to_anchor=(1.02, 1.0),
                      ncol=1, frameon=False)
            caption(fig, "line1: SHAP waterfall (single-sample prediction decomposition)",
                    "sample %s (most confident RF prediction), %d core genes" % (samples[sample_idx], len(core)),
                    "f(X) = E[f(X)] + sum(SHAP); red = toward %s, blue = toward %s"
                    % (CASE_GROUP, CONTROL_GROUP))
            fig.subplots_adjust(left=0.16, right=0.72, top=0.96, bottom=0.12)
            fig.savefig(os.path.join(FIGDIR, "l1_26_shap_waterfall.png"))
            plt.close(fig)
            log("wrote l1_26_shap_waterfall.png (sample=%s)" % samples[sample_idx])
    except Exception as e:
        log("SHAP 瀑布图失败（跳过）：%s" % str(e)[:120])

# l1_23 聚类热图（行=基因，列=样本，附树状图与分组色条）
fig = plt.figure(figsize=(14, max(6.5, len(core) * 0.42) + 2.2))
gs = fig.add_gridspec(3, 1, height_ratios=[1.1, 0.22, 3.2], hspace=0.06)
ax_d = fig.add_subplot(gs[0])
ax_g = fig.add_subplot(gs[1])
ax_h = fig.add_subplot(gs[2])
d = dendrogram(link, ax=ax_d, no_labels=True, color_threshold=0)
order = d["leaves"]
ax_d.set_xticks([])
ax_d.set_yticks([])
ax_d.set_ylabel("ward dist.", fontsize=8)
for sp in ax_d.spines.values():
    sp.set_visible(False)
ax_g.imshow(np.array([y[order]]), aspect="auto",
            cmap=ListedColormap([NEG, POS]), vmin=0, vmax=1)
ax_g.set_xticks([])
ax_g.set_yticks([])
im = ax_h.imshow(Z.T[:, order], aspect="auto", cmap="RdBu_r", vmin=-2, vmax=2)
ax_h.set_yticks(range(len(core)))
ax_h.set_yticklabels(core, fontsize=8)
# 70 样本逐个标名会严重重叠（新规范：X 轴标签不允许重叠）。
# 刻度抽样到约 25 个，保持全量热图数据不变，刻度不再撞字。
_step_cl = max(1, (len(samples) + 24) // 25)
_idx_cl = list(range(0, len(samples), _step_cl))
ax_h.set_xticks(_idx_cl)
ax_h.set_xticklabels([samples[order[i]] for i in _idx_cl], rotation=45, ha="right", fontsize=8)
# 图例与 colorbar 分列：两者原来都挤在热图右侧（colorbar 默认位置 + legend 1.01），
# 窄画布下互相压住（2026-10-19 实测）。现改为
#   热图右缘 0.78 → group 图例紧贴热图（0.79 起）
#   colorbar 用独立 cax 固定在最右（0.90），与图例之间留白
ax_h.legend(handles=[Patch(color=NEG, label=CONTROL_GROUP),
                     Patch(color=POS, label=CASE_GROUP)],
            fontsize=8, loc="upper left", bbox_to_anchor=(1.01, 1.0),
            borderaxespad=0, frameon=False, title="group")
caption(fig, "line1: sample clustering on core hub genes (ward, z-scored)",
        "row = gene, col = sample; ARI vs %s/%s = %.3f"
        % (CASE_GROUP, CONTROL_GROUP, ari),
        "top bar = group; n=%d samples, %d core genes" % (len(samples), len(core)))
fig.subplots_adjust(left=0.14, right=0.78, top=0.97, bottom=0.18)
# cax 必须在 subplots_adjust 之后建，否则位置被重排覆盖
cax = fig.add_axes([0.90, 0.38, 0.018, 0.28])
fig.colorbar(im, cax=cax, label="expression z-score")
fig.savefig(os.path.join(FIGDIR, "l1_23_cluster_heatmap.png"))
plt.close(fig)
log("wrote l1_23_cluster_heatmap.png")

# l1_24 相关性网络
G = nx.Graph()
for _, r in sel.iterrows():
    G.add_edge(r["source"], r["target"], r=float(r["spearman_r"]))
G.add_nodes_from(core)
pos = nx.spring_layout(G, seed=SEED, k=0.9)
plt.rcParams["figure.autolayout"] = False
fig, ax = plt.subplots(figsize=(11, 9))
norm = Normalize(vmin=-1, vmax=1)
cmap = plt.get_cmap("RdBu_r")
edges_list = list(G.edges())
ecolors = [cmap(norm(G[u][v]["r"])) for u, v in edges_list]
ewidths = [0.6 + 3.0 * abs(G[u][v]["r"]) for u, v in edges_list]
nx.draw_networkx_edges(G, pos, ax=ax, edge_color=ecolors, width=ewidths, alpha=0.8)
degs = dict(G.degree())
nx.draw_networkx_nodes(G, pos, ax=ax,
                       node_size=[200 + 70 * degs.get(n, 0) for n in G.nodes()],
                       node_color="#4C72B0", alpha=0.9)
nx.draw_networkx_labels(G, pos, ax=ax, font_size=8)
ax.axis("off")
sm_ = plt.cm.ScalarMappable(cmap=cmap, norm=norm)
sm_.set_array([])
fig.colorbar(sm_, ax=ax, shrink=0.55, label="Spearman r")
caption(fig, "line1: core hub gene co-expression network",
        "edge = Spearman r (width proportional to |r|), node size = degree",
        "%d nodes, %d edges (|r|>=0.5 or top10); n=%d samples" % (G.number_of_nodes(), G.number_of_edges(), len(samples)))
fig.subplots_adjust(left=0.03, right=0.82, top=0.97, bottom=0.06)
fig.savefig(os.path.join(FIGDIR, "l1_24_corr_network.png"))
plt.close(fig)
plt.rcParams["figure.autolayout"] = True
log("wrote l1_24_corr_network.png")

