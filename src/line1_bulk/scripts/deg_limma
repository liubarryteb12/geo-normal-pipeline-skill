#!/usr/bin/env bash
# PROVENANCE: INDEPENDENT  本脚本出图代码为独立实现，未派生自 reference/05.可参考出图代码 的源码；
# deg_limma：line1_bulk 步骤 7 的差异分析部分（limma，LS vs NLS 两组比较）。
# WGCNA 部分不在本脚本（样本量不足时 WGCNA 不可靠，见 line1 README 状态）。
#
# 做法：design ~0+group，对照按字典序后者减前者（如 NLS-LS，log2FC 正 = 后者高），
# lmFit -> contrasts.fit -> eBayes(trend=TRUE)（log2 芯片数据适用 trend）。
# 显著标准来自建项时锁死的 analysis_cutoffs（三档 log2FC 0.5/1/2 与 p 0.1/0.05/0.05，
# 客户勾选是否用 adj.P 判定）。跑的时候只读不写，阈值不随结果调整，防 p-hacking。
# 没有 project.json 的直接手跑场景回落标准档（|log2FC| > 1 且 adj.P.Val < 0.05）。
#
# 注意：两组比较在该数据集上完全可能 0 显著基因（小样本 + 效应弱时 BH 校正后无基因通过）。
# 这是真实分析结果：脚本照常出全量统计表与报告，0 显著也 exit 0，但报告里写明
# 最小 adj.P.Val 与建议动作，不伪造显著、不静默。
#
# 产物（写入工作目录 <line>/processed/）：deg_all.tsv / deg_sig.tsv / deg_report.txt；
# 图件写入 <line>/figures/l1_03_volcano_limma.png（PNG 300dpi，figure_spec v2.2）。
set -euo pipefail

RSCRIPT_BIN="${BIOANALYS_RSCRIPT:-/mnt/ssd/bio_data/ops/layout_autoload/bin/Rscript}"

seed="${BIOANALYS_SEED:-UNSET}"
if [ "$seed" = "UNSET" ]; then
  echo "BIOANALYS_SEED 未注入（引擎契约：seed 必须注入）" >&2
  exit 3
fi

declare -a INPUTS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --input) INPUTS+=("$2"); shift 2 ;;
    --output) shift 2 ;;
    --seed) shift 2 ;;
    *) echo "未知参数: $1" >&2; exit 2 ;;
  esac
done

# 输入按文件名特征分流。模式必须前后都带 *：拿到的是绝对路径，前缀匹配永远不中（坑 #99）。
expr_file=""
group_file=""
for path in "${INPUTS[@]:-}"; do
  [ -n "$path" ] || continue
  case "$path" in
    *expr_genes*.tsv) expr_file="$path" ;;
    *group_map*.tsv) group_file="$path" ;;
    *) echo "无法识别的输入文件: $path（需要 expr_genes/group_map）" >&2; exit 2 ;;
  esac
done

if [ -z "$expr_file" ] || [ -z "$group_file" ]; then
  echo "缺少必需输入：expr_genes 与 group_map 都必须提供（当前 expr='$expr_file' group='$group_file'）" >&2
  exit 2
fi
for required in "$expr_file" "$group_file"; do
  if [ ! -f "$required" ]; then
    echo "输入文件不存在: $required" >&2
    exit 2
  fi
done

echo "step_executed=deg_limma"
echo "bioanalys_seed=${seed}"
echo "input_expr=${expr_file}"
echo "input_group_map=${group_file}"

EXPR_FILE="$expr_file" GROUP_FILE="$group_file" BIOANALYS_SEED="$seed" \
"$RSCRIPT_BIN" --vanilla - <<'RSCRIPT'
suppressPackageStartupMessages({library(data.table); library(limma); library(ggplot2)})

expr_file  <- Sys.getenv("EXPR_FILE")
group_file <- Sys.getenv("GROUP_FILE")
seed       <- Sys.getenv("BIOANALYS_SEED")

fail <- function(message) {
  cat(sprintf("deg_limma 自校验失败: %s\n", message), file = stderr())
  quit(status = 1)
}

expr <- fread(expr_file)
group_map <- fread(group_file)
if (names(expr)[1] != "gene") fail("expr 首列不是 gene")
samples <- setdiff(names(expr), "gene")
if (!setequal(samples, group_map$sample)) fail("样本集合与 group_map 不一致")
mat <- as.matrix(expr[, .SD, .SDcols = samples])
rownames(mat) <- expr$gene
if (any(is.na(mat))) fail("表达矩阵含 NA")

# 尺度守卫（生信代码专项审核）：limma 的 lmFit/eBayes 假定输入已是 log2 尺度。
# 若直接喂原始计数，logFC 会被算成「差值的 log2 比」，量纲完全错。
# 实测证据（GSE316126 NanoString 原始计数，782 基因 36 样本）：
#   原始尺度喂入 -> max|log2FC| = 15113（荒谬），min_padj = 0.869
#   先 log2(x+1) 再喂 -> max|log2FC| = 2.47（合理），min_padj = 0.583
# 判据用「上四分位数 > 50」：log2 尺度的表达矩阵上四分位通常是个位数到十几，
# 而原始计数的中位数就已几百。这个阈值足够区分两种尺度，不会误伤正常的 log2 数据。
#
# 为什么本步还要查一遍（prep_matrix 已有值域校验，不得视为重复而删除）：
#   prep_matrix 在 line1 正常流水线上会保证 log2 量纲（counts 走 CPM+log2，
#   并有「值域超出 [0,20] 即 fail」的自校验）。本守卫是纵深防御，覆盖两种绕过路径：
#     a) 直接手跑 deg_limma 绕过 prep_matrix（排障、复查、换数据集时常见）；
#     b) 上游换数据源后 prep_matrix 的形态判断被误触发而放行。
#   实测正常管线产出 q75=2.70，本守卫放行，不会误报。
q75 <- as.numeric(quantile(mat, 0.75, na.rm = TRUE))
if (q75 > 50) {
  fail(sprintf(paste0("表达矩阵疑似未经 log 变换（上四分位数 %.2f > 50）：",
                      "limma 要求 log2 尺度输入，原始计数会让 logFC 量纲失真。",
                      "请先做 log2(x+1) 或 voom 变换后再提交"), q75))
}
groups <- factor(setNames(group_map$group, group_map$sample)[samples])
if (length(levels(groups)) != 2) fail("deg_limma 只支持两组比较")
if (min(table(groups)) < 2) fail("有分组样本数不足 2")

set.seed(as.integer(seed))
design <- model.matrix(~ 0 + groups)
colnames(design) <- levels(groups)
fit <- lmFit(mat, design)
# 对照：字典序在后的组减在前者（levels 按字母序），方向写进报告，不靠猜
contrast_text <- sprintf("%s-%s", levels(groups)[2], levels(groups)[1])
fit2 <- contrasts.fit(fit, makeContrasts(contrasts = contrast_text, levels = design))
fit2 <- eBayes(fit2, trend = TRUE)
deg <- topTable(fit2, number = Inf, sort.by = "P")

deg_table <- data.table(
  gene = rownames(deg),
  log2FC = round(deg$logFC, 4),
  AveExpr = round(deg$AveExpr, 4),
  t = round(deg$t, 4),
  P_Value = signif(deg$P.Value, 4),
  adj_P_Val = signif(deg$adj.P.Val, 4)
)
if (any(is.na(deg_table$log2FC)) || any(is.na(deg_table$adj_P_Val))) fail("统计结果含 NA")

# 阈值真源：project.json 的 analysis_cutoffs（第二十九轮契约）。
# 三档 log2FC 0.5/1/2 与 p 0.1/0.05/0.05 由客户在提交页选定，建项时锁死进台账，
# 事后不可逆（防按结果反复调阈值）。直接手跑母版时没有 project.json，才回落标准档。
read_cutoffs <- function() {
  fallback <- list(log2fc = 1, p_field = "padj", p_cut = 0.05)
  path <- Sys.getenv("BIOANALYS_PROJECT_JSON", "")
  if (!nzchar(path) || !file.exists(path)) return(fallback)
  if (!requireNamespace("jsonlite", quietly = TRUE)) return(fallback)
  parsed <- tryCatch(jsonlite::fromJSON(path, simplifyVector = FALSE), error = function(e) NULL)
  cut <- parsed$analysis_cutoffs
  if (is.null(cut) || !is.list(cut)) return(fallback)
  num <- function(x, d) {
    if (is.null(x) || !is.numeric(x) || length(x) != 1 || !is.finite(x) || x <= 0) d else as.numeric(x)
  }
  list(
    log2fc = num(cut$log2fc_threshold, fallback$log2fc),
    p_field = if (identical(cut$effective_p_field, "pvalue")) "pvalue" else "padj",
    p_cut = num(cut$effective_p_threshold, fallback$p_cut)
  )
}
cut <- read_cutoffs()
logfc_cut <- cut$log2fc
padj_cut <- cut$p_cut
p_used <- if (cut$p_field == "pvalue") deg_table$P_Value else deg_table$adj_P_Val
p_label <- if (cut$p_field == "pvalue") "p" else "adj p"
deg_table[, is_sig := abs(log2FC) > logfc_cut & p_used < padj_cut]

# --- 队列效应诊断列（生信代码专项审核 P1）---
# 病灶：跨队列比较（如新鲜活检 vs 重新对齐的历史系列）时，某基因可能在某一组里
# 几乎全为零（单侧沉默），它会被 limma 判成"高度显著"，但那是批次差异不是生物学差异。
# DCM 基准实测 43,098 个基因里 11,841 个（27%）属此类，直接把 AUC 推到 1.000。
# 这里给每行打三个可机读标记，让下游能自己过滤，而不必依赖报告里的口头说明。
group_levels <- levels(groups)
case_idx <- which(groups == group_levels[2])
ctrl_idx <- which(groups == group_levels[1])
silent_share <- function(idx) {
  if (length(idx) == 0) return(rep(NA_real_, nrow(mat)))
  rowSums(mat[, idx, drop = FALSE] <= 0) / length(idx)
}
deg_table[, case_zero_share := round(silent_share(case_idx), 4)]
deg_table[, ctrl_zero_share := round(silent_share(ctrl_idx), 4)]
# 单侧沉默：一组 >=95% 为零，另一组 <50% 为零
deg_table[, is_single_side_silent :=
  (case_zero_share >= 0.95 & ctrl_zero_share < 0.5) |
  (ctrl_zero_share >= 0.95 & case_zero_share < 0.5)]
# 低检出：两组中位表达都 <= 0（表达量过低，统计量不可靠）
deg_table[, is_low_detection :=
  (case_zero_share >= 0.5) & (ctrl_zero_share >= 0.5)]
# 技术性非编码：基因名形如 __ ambiguous / ERCC / 无 symbol 的占位
deg_table[, is_technical := grepl("^(ERCC|__|LOC\\d+$)", gene) | !nzchar(gene)]
deg_table[, cohort_suspect := is_single_side_silent | is_low_detection | is_technical]

sig_table <- deg_table[is_sig == TRUE][order(adj_P_Val)]
fwrite(deg_table[, !"is_sig"], "deg_all.tsv", sep = "\t")
# 0 显著时也要落带表头的空表：下游拿不到文件比空表更难排查
fwrite(sig_table[, !"is_sig"], "deg_sig.tsv", sep = "\t")

# 队列过滤版显著表（与 deg_sig.tsv 并行，不删原行）：审核建议的第三张表。
# 保留 deg_all.tsv / deg_sig.tsv 的行数与字段兼容，过滤只出新文件，
# 让"看到什么"和"信什么"两件事各自可追溯。
sig_filtered <- sig_table[cohort_suspect == FALSE]
fwrite(sig_filtered[, !"is_sig"], "deg_sig_cohortfiltered.tsv", sep = "\t")
n_suspect <- sum(deg_table$cohort_suspect)
n_sig_suspect <- sum(sig_table$cohort_suspect)
cat("cohort_diagnostics=1\n", sep = "")
cat("single_side_silent=", sum(deg_table$is_single_side_silent), "\n", sep = "")
cat("low_detection=", sum(deg_table$is_low_detection), "\n", sep = "")
cat("technical=", sum(deg_table$is_technical), "\n", sep = "")
cat("cohort_suspect_total=", n_suspect, "\n", sep = "")
cat("sig_before_filter=", nrow(sig_table), "\n", sep = "")
cat("sig_after_filter=", nrow(sig_filtered), "\n", sep = "")
cat("sig_removed=", n_sig_suspect, "\n", sep = "")

# 三分类配色对齐 figure_spec v2.2 与第二十九轮 Argon 裁定：
# 上调红 #EE0000 / 下调蓝 #3B4992 / 不显著灰 #BEBEBE。只按"显著与否"上色会让
# 上调下调同色，读者看不出方向，所以判据拆成 Up / NS / Down 三档。
deg_table[, direction := factor(
  ifelse(is_sig & log2FC > 0, "Up", ifelse(is_sig & log2FC < 0, "Down", "NS")),
  levels = c("Up", "NS", "Down"))]
dir_counts <- table(deg_table$direction)
legend_labels <- c(
  Up = sprintf("Up (n=%d)", as.integer(dir_counts[["Up"]])),
  NS = sprintf("NS (n=%d)", as.integer(dir_counts[["NS"]])),
  Down = sprintf("Down (n=%d)", as.integer(dir_counts[["Down"]])))
y_max <- max(-log10(deg_table$P_Value), na.rm = TRUE)
theme_set(theme_bw(base_size = 7, base_family = "sans"))  # 统一字号 7pt 与无衬线字体
p <- ggplot(deg_table, aes(x = log2FC, y = -log10(P_Value))) +
  geom_point(aes(color = direction), alpha = 0.65, size = 1.2) +
  scale_color_manual(values = c(Up = "#EE0000", NS = "#BEBEBE", Down = "#3B4992"),
                     labels = legend_labels, drop = FALSE, name = NULL) +
  geom_vline(xintercept = c(-logfc_cut, logfc_cut), colour = "grey35",
             linetype = "dashed", linewidth = 0.35) +
  geom_hline(yintercept = -log10(padj_cut), colour = "grey35",
             linetype = "dashed", linewidth = 0.35) +
  # 阈值线必须在图内标注（figure_spec §三之三）：p 阈值贴左侧轴框内缘，
  # log2FC 竖直标注置轴框顶部，避免被点云遮挡。口径不同标注不能混用：
  # 用 adj.P 判显著写 adj p，用名义 p 判显著写 p。
  annotate("text",
           x = min(deg_table$log2FC, na.rm = TRUE) + 0.02 * diff(range(deg_table$log2FC, na.rm = TRUE)),
           y = -log10(padj_cut) + 0.04 * y_max,
           label = sprintf("%s=%g", p_label, padj_cut),
           hjust = 0, vjust = 0, size = 2.8) +
  annotate("text", x = logfc_cut, y = y_max,
           label = sprintf("log2FC=%g", logfc_cut),
           angle = 90, hjust = 1, vjust = 1, size = 2.8) +
  annotate("text", x = -logfc_cut, y = y_max,
           label = sprintf("log2FC=-%g", logfc_cut),
           angle = 90, hjust = 1, vjust = 1, size = 2.8) +
  labs(x = "log2 fold change", y = sprintf("-log10 %s", p_label),
       # 画布固定 88mm 宽（layout_autoload 的 template_4x3），8pt 一行只放得下
       # 约 40 字符；图注超过这个宽度会被 ggsave 裁掉左端，所以逐条压短。
       caption = paste(
    "line1: limma DEG volcano",
    sprintf("threshold |log2FC|>%g & %s<%g", logfc_cut, p_label, padj_cut),
    sprintf("%d genes, %d significant", nrow(deg_table), nrow(sig_table)),
    "red = up, blue = down, grey = NS",
    sep = "\n")) +
  theme_classic(base_size = 12) +
  theme(legend.position = "right",
        legend.frame = element_blank(),
        legend.text = element_text(size = 8),
        legend.title = element_blank(),
        plot.caption.position = "plot",
        plot.caption = element_text(hjust = 0, size = 8))
# 出图规范 v2.2：PNG 300dpi 落 <line>/figures/
dir.create("../figures", showWarnings = FALSE, recursive = TRUE)
deg_png <- "../figures/l1_03_volcano_limma.png"
ggsave(deg_png, p, width = 6, height = 5, dpi = 300)

top_by_p <- head(deg_table[order(adj_P_Val)], 10)
report_lines <- c(
  sprintf("step=deg_limma"),
  sprintf("seed=%s", seed),
  sprintf("expr=%s", expr_file),
  sprintf("group_map=%s", group_file),
  sprintf("contrast=%s", contrast_text),
  sprintf("method=limma lmFit + eBayes(trend=TRUE)"),
  sprintf("thresholds=|log2FC|>%g & %s<%g (%s)", logfc_cut, p_label, padj_cut,
          if (cut$p_field == "pvalue") "nominal p" else "adjusted p"),
  sprintf("genes_tested=%d", nrow(deg_table)),
  sprintf("sig_genes=%d (up=%d down=%d)", nrow(sig_table),
          sum(sig_table$log2FC > 0), sum(sig_table$log2FC < 0)),
  sprintf("min_adj_P_Val=%.4g", min(deg_table$adj_P_Val)),
  sprintf("max_abs_log2FC=%.2f", max(abs(deg_table$log2FC))),
  sprintf("figure=%s (300dpi PNG)", deg_png),
  sprintf("top10_by_p=%s", paste(sprintf("%s(%.2g)", top_by_p$gene, top_by_p$adj_P_Val), collapse = " "))
)
if (nrow(sig_table) == 0) {
  # 0 显著是真实结果，报告必须写清证据与建议，不静默不伪造
  report_lines <- c(report_lines,
    "note=无基因通过显著阈值。证据：最小 adj.P.Val 见上行；该对比为小样本两组比较，",
    "note=BH 校正后无基因通过属真实结果。建议：增加独立队列样本量，或在新数据上",
    "note=复跑本步骤（阈值不随结果调整）。")
}
writeLines(report_lines, "deg_report.txt")
for (artifact in c("deg_all.tsv", "deg_sig.tsv", "deg_report.txt", deg_png)) {
  if (!file.exists(artifact) || file.info(artifact)$size == 0) {
    fail(sprintf("产物缺失或为空: %s", artifact))
  }
}

cat("contrast=", contrast_text, "\n", sep = "")
cat("genes_tested=", nrow(deg_table), "\n", sep = "")
cat("sig_genes=", nrow(sig_table), " (up=", sum(sig_table$log2FC > 0), " down=", sum(sig_table$log2FC < 0), ")\n", sep = "")
cat("min_adj_P_Val=", sprintf("%.4g", min(deg_table$adj_P_Val)), "\n", sep = "")
if (nrow(sig_table) == 0) {
  cat(sprintf("NOTE=无基因通过 |log2FC|>%g & %s<%g，报告已写明证据与建议（见 deg_report.txt）\n",
              logfc_cut, p_label, padj_cut))
}
# 图形设备兜底（figure_spec 第 3 节 / Argon 第 65 轮 Q3）：各图已成对 dev.off()，
# 收尾再 graphics.off() 兜住异常分支残留的设备，防单步跑多图时峰值内存叠加。
graphics.off()
RSCRIPT

echo "deg_limma done: deg_all.tsv / deg_sig.tsv / deg_report.txt 已写入 $(pwd)；图件 ../figures/l1_03_volcano_limma.png"