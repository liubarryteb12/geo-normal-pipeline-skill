#!/usr/bin/env bash
# PROVENANCE: INDEPENDENT  本脚本出图代码为独立实现，未派生自 reference/05.可参考出图代码 的源码；
# ppi_string：line1_bulk 步骤 8 的 PPI / hub 基因部分（STRING 边表，离线优先）。
#
# 输入（同 cwd）：wgcna_modules.tsv（gene/module）+ wgcna_module_trait.tsv
#   （module/significant），取"与分组显著相关"的模块基因做 PPI。
#   DEG 0 显著（BH 后无基因通过），故 PPI 输入取 WGCNA 显著模块基因而非 DEG。
#
# 做法（用户 2026-10-13 拍板 PPI 在线富集可做；2026-10-21 改为离线优先）：
#   1. 显著模块基因（tan + plum1）取互作边：先读本机 STRING v12.0 离线文件
#      （9606.protein.links.v12.0 + 9606.protein.info.v12.0，路径见下），
#      离线文件完全不存在时才回落 STRING 网络 API；
#   2. 计算 degree 得 hub 基因（top 30）；
#   3. 画 PPI 网络图（networkx spring layout，单图，只画 top 边避免糊成一团）；
#   4. 落边表 / hub 表 / 报告。
#
# 离线文件路径（环境变量可覆盖；压缩包与解压后的同名 .txt 都支持，按扩展名选读取方式）：
#   BIO_STRING_LINKS  默认 /mnt/ssd/bio_data/public_references/stringdb/9606.protein.links.v12.0.txt.gz
#   BIO_STRING_INFO   默认 /mnt/ssd/bio_data/public_references/stringdb/9606.protein.info.v12.0.txt.gz
#   BIO_STRING_MIN_SCORE  默认 400（STRING combined_score 0..1000 口径）
#
# 自校验内建：输入存在、显著模块非空、边数 > 0、hub 非空、degree 与边表一致。
# 两条路都拿不到边表时打印 STRING v12.0 下载指引并以 1 退出，不静默降级。
set -euo pipefail

seed="${BIOANALYS_SEED:-UNSET}"
if [ "$seed" = "UNSET" ]; then
  echo "BIOANALYS_SEED 未注入（引擎契约：seed 必须注入）" >&2
  exit 3
fi

declare -a INPUTS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --input) INPUTS+=("$2"); shift 2 ;;
    --output) shift 2 ;;
    --seed) shift 2 ;;
    *) echo "未知参数: $1" >&2; exit 2 ;;
  esac
done

mod_file=""
trait_file=""
for path in "${INPUTS[@]:-}"; do
  [ -n "$path" ] || continue
  case "$path" in
    *wgcna_modules*.tsv) mod_file="$path" ;;
    *wgcna_module_trait*.tsv) trait_file="$path" ;;
    *) echo "无法识别的输入文件: $path（需要 wgcna_modules / wgcna_module_trait）" >&2; exit 2 ;;
  esac
done
if [ -z "$mod_file" ]; then
  echo "缺少必需输入：wgcna_modules.tsv" >&2
  exit 2
fi
# trait 文件缺省按同目录固定名找
if [ -z "$trait_file" ]; then
  guess="$(dirname "$mod_file")/wgcna_module_trait.tsv"
  [ -f "$guess" ] && trait_file="$guess"
fi
[ -f "$mod_file" ] || { echo "输入不存在: $mod_file" >&2; exit 2; }

echo "step_executed=ppi_string"
echo "bioanalys_seed=${seed}"
echo "input_modules=${mod_file}"
echo "input_trait=${trait_file}"

# 解释器 PATH 前置（生信代码专项审核）：K40 系统解释器缺科学计算包，真依赖在 bio-py venv。
# 用 PATH 注入而非改写调用行，是为了让桥接调用的行级计数保持原样（bilingual 判定不变）。
BIO_PY_BIN="${BIO_PY_BIN:-/root/venvs/bio-py/bin}"
if [ -x "$BIO_PY_BIN/python3" ]; then
  export PATH="$BIO_PY_BIN:$PATH"
fi

MOD_FILE="$mod_file" TRAIT_FILE="$trait_file" BIOANALYS_SEED="$seed" \
python3 - <<'PYSCRIPT'
import gzip
import json
