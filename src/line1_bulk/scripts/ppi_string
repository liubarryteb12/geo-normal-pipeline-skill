def fail(m):
    sys.stderr.write("ppi_string 自校验失败: %s\n" % m)
    sys.stderr.flush()
    sys.exit(1)


def warn(m):
    sys.stderr.write("ppi_string warn: %s\n" % m)
    sys.stderr.flush()


def log(m):
    print(m, flush=True)


def env_int(name, default):
    """整数环境变量：未设或空串取默认值；设了但不是整数就明确失败（不静默取默认）。"""
    raw = os.environ.get(name)
    if raw is None or raw.strip() == "":
        return default
    try:
        return int(raw.strip())
    except ValueError:
        fail("%s 必须是整数（当前值 %r）" % (name, raw))


def env_str(name, default):
    """字符串环境变量：未设或空串取默认值。取值合法性由调用方校验（便于给出精确报错）。"""
    raw = os.environ.get(name)
    return raw.strip() if raw and raw.strip() else default


def env_path(name, default):
    raw = os.environ.get(name)
    return raw.strip() if raw and raw.strip() else default


def path_variants(p):
    """同一份数据的压缩/未压缩两种命名：.gz 与同名 .txt 互为备选。"""
    return [p, p[:-3]] if p.endswith(".gz") else [p, p + ".gz"]


def resolve_offline(p):
    """按候选顺序找离线文件，返回实际存在的路径；都不存在返回 None。"""
    for cand in path_variants(p):
        if os.path.isfile(cand):
            return cand
    return None


def open_text(path):
    """按扩展名选读取方式：.gz 走 gzip 流，其余按纯文本流。"""
    if path.endswith(".gz"):
        return gzip.open(path, "rt", encoding="utf-8", errors="replace", newline="")
    return open(path, "r", encoding="utf-8", errors="replace", newline="")


def print_download_guidance(reason, links_target, info_target):
    """离线文件缺失时的可执行指引：给出下载 URL 与应放的目标路径，不让人去猜。"""
    msg = [
        "ppi_string 拿不到 STRING 边表：%s" % reason,
        "请下载 STRING v12.0 离线文件后放到目标路径（压缩包与解压后的 .txt 都支持）：",
        "  links 目标: %s" % links_target,
        "  links 下载: %s" % LINKS_URL,
        "  info  目标: %s" % info_target,
        "  info  下载: %s" % INFO_URL,
        "也可用 BIO_STRING_LINKS / BIO_STRING_INFO 指向别处（例如 /mnt/ssd/bio_data/ 下已有副本）。",
    ]
    sys.stderr.write("\n".join(msg) + "\n")
    sys.stderr.flush()


# 离线文件读到一半出错，九成是下载中断（.gz 缺结束标记）。这类异常必须折成可执行的
# 修复指引，而不是丢一个 traceback 让人猜（P-19：K40 上 curl 被中断留下 2.4MB 残片）。
READ_ERRORS = (OSError, EOFError, zlib.error, UnicodeDecodeError)


def read_failure_msg(kind, path, exc):
    return ("离线 %s 读取失败（%s: %s），文件可能是下载中断的残片：%s。"
            "先跑 gzip -t %s 验证，不通过就删掉重下（curl -C - 可续传）"
            % (kind, type(exc).__name__, exc, path, path))


def norm_protein(pid):
    """STRING 蛋白 ID 归一：去掉 9606. 物种前缀，让 links 与 info 两侧能对齐。"""
    pid = pid.strip()
    if "." in pid:
        head, tail = pid.split(".", 1)
        if head.isdigit():
            return tail
    return pid


def looks_like_ensp(token):
    return re.match(r"^(?:\d+\.)?ENSP\d+$", token or "") is not None


def load_protein_info(path, wanted_symbols):
    """流式读 protein.info，只为待查基因建双向映射（不整表读入内存）。
    返回 (symbol -> [ensp], ensp -> symbol, 数据行数)。"""
    sym2ensp = {}
    ensp2sym = {}
    n_rows = 0
    with open_text(path) as fh:
        for line in fh:
            if not line.strip() or line.startswith("#"):
                continue          # 表头 #string_protein_id 等注释行
            parts = line.rstrip("\n").split("\t")
            if len(parts) < 2:
                parts = line.split()
            if len(parts) < 2:
                continue
            n_rows += 1
            ensp = norm_protein(parts[0])
            sym = parts[1].strip()
            if sym and sym in wanted_symbols:
                sym2ensp.setdefault(sym, []).append(ensp)
                ensp2sym.setdefault(ensp, sym)
    return sym2ensp, ensp2sym, n_rows


def scan_links(path, wanted_ensp, min_score, scope="any"):
    """流式扫 protein.links（human v12.0 约 1200 万行）：每行只取前 3 列，
    先按查询集与阈值过滤再落字典，内存里只留命中查询基因的边。
    返回 ({(a, b): score}, 统计)。重复边（含反向重复）保留最高分。

    scope 决定边的纳入口径（生信审核发现的实际缺陷）：
      "any"  ：只要一端在查询集内就保留（历史默认，会引入大量外部蛋白）
      "both" ：两端都必须在查询集内（限定网络，与本步骤「显著模块基因做 PPI」的设计意图一致）

    为什么需要 both：用 782 基因的 NanoString 面板实测，any 口径引入 7,497 个外部蛋白，
    边数从 12,332 放大到 89,826（7.28 倍），hub 分析会被外部节点污染；both 才是
    「这批基因内部的互作图」。默认保留 any 是为了不让既有结果静默改变，
    要限定网络需显式设置 BIO_STRING_SCOPE=both。"""
    edges = {}
    stats = {"rows": 0, "low": 0, "dup": 0, "self": 0, "outside": 0}
    with open_text(path) as fh:
        for line in fh:
            if not line.strip() or line.startswith("#") or line.startswith("protein1"):
                continue
            parts = line.split(None, 3)[:3]
            if len(parts) < 3:
                continue
            stats["rows"] += 1
            a = norm_protein(parts[0])
            b = norm_protein(parts[1])
            in_a = a in wanted_ensp
            in_b = b in wanted_ensp
            if scope == "both":
                # 限定网络：任一端在外即跳过（不把外部蛋白拉进图里）
                if not (in_a and in_b):
                    if in_a or in_b:
                        stats["outside"] = stats.get("outside", 0) + 1
                    continue
            elif not (in_a or in_b):
                continue
            if a == b:
                stats["self"] += 1
                continue
            try:
                score = int(parts[2])
            except ValueError:
                continue
            if score < min_score:
                stats["low"] += 1
                continue
            key = (a, b) if a <= b else (b, a)
            old = edges.get(key)
            if old is None:
                edges[key] = score
            else:
                stats["dup"] += 1
                if score > old:
                    edges[key] = score
    return edges, stats


def edges_to_table(raw_edges, ensp2sym):
    """ENSP 边表转基因符号表：映射缺失时保留 ENSP 原名并 warn，不静默丢边。
    combined_score 统一成 0..1 浮点（离线原始分为 0..1000 整数，除以 1000），
    与改动前 STRING API 的 score 列同量纲，下游不用改。"""
    warned = set()

    def note_unmapped(pid):
        """缺符号映射只逐条提醒前 MAX_UNMAPPED_WARN 个：真实查询集上千基因时
        逐条 warn 会把 stderr 刷成几千行，反而看不见别的错误。"""
        if pid in warned:
            return
        warned.add(pid)
        if len(warned) <= MAX_UNMAPPED_WARN:
            warn("protein.info 缺 %s 的基因符号，输出保留 ENSP 原名" % pid)
        elif len(warned) == MAX_UNMAPPED_WARN + 1:
            warn("protein.info 缺符号映射的 ENSP 已超过 %d 个，后续不再逐条提醒"
                 "（这些边仍然保留 ENSP 原名，不会被丢弃）" % MAX_UNMAPPED_WARN)

    best = {}
    for (a, b), score in raw_edges.items():
        ga = ensp2sym.get(a)
        if ga is None:
            ga = a
            note_unmapped(a)
        gb = ensp2sym.get(b)
        if gb is None:
            gb = b
            note_unmapped(b)
        if ga == gb:
            continue          # 同一基因的两个蛋白异构体，折叠成自环无意义
        key = (ga, gb) if ga <= gb else (gb, ga)
        if key not in best or score > best[key]:
            best[key] = score
    rows = [{"gene_a": a, "gene_b": b, "combined_score": round(s / 1000.0, 3)}
            for (a, b), s in best.items()]
    rows.sort(key=lambda r: (-r["combined_score"], r["gene_a"], r["gene_b"]))
    return pd.DataFrame(rows, columns=["gene_a", "gene_b", "combined_score"])


def fetch_api_edges(genes, min_score):
    """回落路径：STRING 网络 API（POST，避免 URL 过长）。离线文件完全不存在时才用。"""
    url = "https://string-db.org/api/tsv/network"
    body = urllib.parse.urlencode({
        "identifiers": "\r".join(genes),
        "species": SPECIES,
        "required_score": min_score,
    }).encode()
    req = urllib.request.Request(url, data=body,
                                 headers={"User-Agent": "BioanalysDesktop/0.1"})
    try:
        with urllib.request.urlopen(req, timeout=90) as resp:
            raw = resp.read().decode("utf-8")
    except Exception as e:
        return None, "STRING API 调用失败：%s" % e
    lines = [ln for ln in raw.splitlines() if ln.strip()]
    if len(lines) < 2:
        return None, "STRING API 返回 %d 行（<2），无互作边（阈值 %d 可能过高）" % (len(lines), min_score)
    header = lines[0].split("\t")
    rows = [dict(zip(header, ln.split("\t"))) for ln in lines[1:]]
    out = pd.DataFrame({
        "gene_a": [r["preferredName_A"] for r in rows],
        "gene_b": [r["preferredName_B"] for r in rows],
        "combined_score": [float(r["score"]) for r in rows],
    })
    out = out.drop_duplicates(subset=["gene_a", "gene_b"]).reset_index(drop=True)
    return out, None


mods = pd.read_csv(os.environ["MOD_FILE"], sep="\t")
trait_file = os.environ.get("TRAIT_FILE", "")
if not trait_file or not os.path.exists(trait_file):
    fail("缺 wgcna_module_trait.tsv（无法确定显著模块）")
trait = pd.read_csv(trait_file, sep="\t")
if "significant" not in trait.columns or "module" not in trait.columns:
    fail("wgcna_module_trait 缺 module/significant 列")
sig_modules = trait.loc[trait["significant"].astype(bool), "module"].astype(str).tolist()
if not sig_modules:
    fail("没有与分组显著相关的模块，PPI 无输入")
genes = sorted(set(mods.loc[mods["module"].astype(str).isin(sig_modules), "gene"].astype(str)))
log("significant modules=%s genes=%d" % (sig_modules, len(genes)))
# 上游零显著时短路（Argon 第 44 轮 4A 裁定）。
# 理由：PPI 的输入应当是差异基因（DEGs）而非全部背景基因。当上游 n_sig < 2 时，
# 没有可比对的差异信号，硬算 PPI 会产出「依托背景基因的拓扑」并可能被误读成发现。
# 这里不是 fail，而是正常跳过并落一份说明文件：缺输入是上游结论（无可报告差异），
# 不是本步骤的失败。下游 reconcile 依据 skip 文件判 SKIPPED 而非 FAILED。
if len(genes) < 2:
    skip_reason = "n_sig=%d < 2（上游无足够显著基因，PPI 无可比对差异，按设计跳过）" % len(genes)
    log("SKIP: %s" % skip_reason)
    skip_doc = {
        "step": "ppi_string",
        "status": "skipped",
        "reason": skip_reason,
        "n_input_genes": int(len(genes)),
        "threshold_required": 2,
        "note": "PPI 需要差异基因输入；上游零显著时本步无意义。"
                "这是上游结论（无可报告差异），不是本步失败。",
        "seed": str(os.environ.get("BIOANALYS_SEED", "")),
    }
    with open("ppi_skip.json", "w", encoding="utf-8") as fh:
        json.dump(skip_doc, fh, ensure_ascii=False, indent=2)
    log("wrote ppi_skip.json")
    sys.exit(0)

# --- 边表来源：离线文件优先，只有离线文件完全不存在才回落网络 API ---
MIN_SCORE = env_int("BIO_STRING_MIN_SCORE", 400)   # STRING combined_score 阈值（中等置信）
if MIN_SCORE < 0 or MIN_SCORE > 1000:
    fail("BIO_STRING_MIN_SCORE 必须落在 0..1000（STRING combined_score 口径），当前 %d" % MIN_SCORE)

links_target = env_path("BIO_STRING_LINKS", DEFAULT_LINKS)
info_target = env_path("BIO_STRING_INFO", DEFAULT_INFO)
links_file = resolve_offline(links_target)
info_file = resolve_offline(info_target)

if links_file and info_file:
    source = "offline"
    source_label = "offline:%s" % os.path.basename(links_file)
elif links_file or info_file:
    # 半套离线数据不回落网络：K40 外网不稳，且缺 info 表只能输出 ENSP，下游会误读
    print_download_guidance(
        "离线数据不完整（缺 %s）" % ("protein.info" if links_file else "protein.links"),
        links_target, info_target)
    sys.exit(1)
else:
    source = "api"
    source_label = "api:string-db.org"
    warn("离线文件不存在（links=%s info=%s），回落 STRING 网络 API" % (links_target, info_target))

if source == "offline":
    wanted_symbols = set(genes)
    try:
        sym2ensp, ensp2sym, n_info = load_protein_info(info_file, wanted_symbols)
    except READ_ERRORS as exc:
        fail(read_failure_msg("protein.info", info_file, exc))
    wanted_ensp = set()
    for sym in genes:
        if sym in sym2ensp:
            wanted_ensp.update(sym2ensp[sym])
        elif looks_like_ensp(sym):
            # 输入直接给 ENSP（排障/测试路径）：照常参与匹配，符号缺失时保留原名
            wanted_ensp.add(norm_protein(sym))
    unmapped = [g for g in genes if g not in sym2ensp and not looks_like_ensp(g)]
    for g in unmapped:
        warn("输入基因 %s 在 protein.info 中无 ENSP 映射，无法匹配互作边" % g)
    if not wanted_ensp:
        fail("输入基因在 protein.info 中一个都映射不到（确认 BIO_STRING_INFO 是 9606 的 info 表）")
    n_sym_mapped = sum(1 for g in genes if g in sym2ensp)
    log("offline_source links=%s info=%s info_rows=%d symbol_mapped=%d/%d ensp_in_query=%d"
        % (links_file, info_file, n_info, n_sym_mapped, len(genes), len(wanted_ensp)))
    # 边的纳入口径：any（历史默认，一端在内）或 both（两端都在内，限定网络）。
    # 要得到「这批基因内部的互作图」必须用 both，否则外部蛋白会淹没网络。
    SCOPE = env_str("BIO_STRING_SCOPE", "any")
    if SCOPE not in ("any", "both"):
        fail("BIO_STRING_SCOPE 只能是 any 或 both，当前 %r" % SCOPE)
    log("edge_scope=%s" % SCOPE)
    try:
        raw_edges, stats = scan_links(links_file, wanted_ensp, MIN_SCORE, scope=SCOPE)
    except READ_ERRORS as exc:
        fail(read_failure_msg("protein.links", links_file, exc))
    log("offline_scan rows=%d low_score=%d dup=%d self=%d kept=%d"
        % (stats["rows"], stats["low"], stats["dup"], stats["self"], len(raw_edges)))
    edges_out = edges_to_table(raw_edges, ensp2sym)
    if edges_out.empty:
        fail("离线边表在 combined_score >= %d 下没有一条落在查询基因之间"
             "（基因数 %d，可能是阈值过高或 info/links 版本不一致）" % (MIN_SCORE, len(genes)))
else:
    edges_out, err = fetch_api_edges(genes, MIN_SCORE)
    if edges_out is None:
        print_download_guidance(err, links_target, info_target)
        sys.exit(1)

log("STRING edges=%d (source=%s, min_score=%d)" % (len(edges_out), source, MIN_SCORE))

# --- degree / hub ---
deg = {}
for _, r in edges_out.iterrows():
    a = r["gene_a"]
    b = r["gene_b"]
    deg[a] = deg.get(a, 0) + 1
    deg[b] = deg.get(b, 0) + 1
hub = pd.DataFrame({"gene": list(deg.keys()), "degree": list(deg.values())})
# degree 降序，同分按基因名升序：边表离线固定后，hub 顺序也必须可复现
hub = hub.sort_values(["degree", "gene"], ascending=[False, True],
                      kind="stable").reset_index(drop=True)
hub.head(200).to_csv("ppi_hubs.tsv", sep="\t", index=False)
edges_out.to_csv("ppi_edges.tsv", sep="\t", index=False)
log("wrote ppi_edges.tsv (%d) + ppi_hubs.tsv (%d genes)" % (len(edges_out), len(hub)))

if len(hub) == 0:
    fail("hub 为空")

# --- 网络图（单图，只画 top 边） ---
try:
    import networkx as nx
    G = nx.Graph()
    for _, r in edges_out.iterrows():
        G.add_edge(r["gene_a"], r["gene_b"], weight=float(r["combined_score"]))
    # 只保留 top-N hub 的子图，避免节点过多糊成一团
    top_nodes = set(hub.head(MAX_HUB)["gene"].tolist())
    H = G.subgraph([n for n in G.nodes() if n in top_nodes]).copy()
    # 边数上限（规范：大网络只画 top N，默认 100 边），按 combined_score 降序截断
    if H.number_of_edges() > MAX_EDGES:
        e_sorted = sorted(H.edges(data=True),
                          key=lambda e: e[2].get("weight", 0.0), reverse=True)
        H = H.edge_subgraph([(a, b) for a, b, _ in e_sorted[:MAX_EDGES]]).copy()
        H.remove_nodes_from([n for n in list(H.nodes()) if H.degree(n) == 0])
    if H.number_of_nodes() >= 2:
        fig, ax = plt.subplots(figsize=(12, 10))
        pos = nx.spring_layout(H, seed=SEED, k=0.6)
        degs = dict(H.degree())
        sizes = [80 + 40 * degs.get(n, 0) for n in H.nodes()]
        # 边权映射：宽度 + 颜色（viridis），并附色条说明（规范：网络类须标注边权）
        ws = [e[2].get("weight", 0.0) for e in H.edges(data=True)]
        wmin, wmax = min(ws), max(ws)
        norm = [(w - wmin) / (wmax - wmin + 1e-9) for w in ws]
        nx.draw_networkx_edges(H, pos, ax=ax, alpha=0.35,
                               width=[0.4 + 1.6 * v for v in norm],
                               edge_color=norm, edge_cmap=plt.cm.viridis)
        nx.draw_networkx_nodes(H, pos, ax=ax, node_size=sizes,
                               node_color="#4C72B0", alpha=0.85)
        nx.draw_networkx_labels(H, pos, ax=ax, font_size=8)
        # 节点标签自动避让（规范 §三之二：图内文字不得互相重叠）。边表来源固定后
        # spring 布局可复现，但高连接度节点仍可能挤在一起压字；
        # 引线保住"标签属于哪个节点"，避免纯位移后标签与节点脱钩。
        from adjustText import adjust_text
        adjust_text(ax.texts, ax=ax, expand=(1.4, 1.6),
                    arrowprops=dict(arrowstyle="-", color="0.75", lw=0.4))
        sm = plt.cm.ScalarMappable(cmap=plt.cm.viridis,
                                   norm=plt.Normalize(wmin, wmax))
        fig.colorbar(sm, ax=ax, shrink=0.5, label="STRING combined score")
        caption(fig, "line1: PPI network (significant WGCNA module genes)",
                "top %d hubs / top %d edges by combined score, STRING"
                % (MAX_HUB, MAX_EDGES))
        ax.axis("off")
        fig.savefig("../figures/l1_07_ppi_network.png")
        plt.close(fig)
        log("wrote ../figures/l1_07_ppi_network.png")
    else:
        log("子图节点 < 2，跳过网络图")
except ImportError:
    log("networkx 未装，跳过网络图")

# --- hub bar（单图） ---
fig, ax = plt.subplots(figsize=(9, 6))
top = hub.head(MAX_HUB).iloc[::-1]
ax.barh(range(len(top)), top["degree"].to_numpy(), color="#C44E52")
ax.set_yticks(range(len(top)))
ax.set_yticklabels(top["gene"].tolist(), fontsize=8)
# 轴标签点明口径：targeted panel 上 degree 不是无偏中心性，别让读者误读
ax.set_xlabel("degree within input set (STRING score>=%d)" % MIN_SCORE)
caption(fig, "line1: PPI hub genes", "top %d by degree" % MAX_HUB)
fig.savefig("../figures/l1_08_ppi_hubs.png")
plt.close(fig)
log("wrote ../figures/l1_08_ppi_hubs.png")

# --- 报告 ---
lines = [
    "step=ppi_string",
    "seed=%d" % SEED,
    "input_modules=%s genes=%d (modules=%s)" % (os.environ["MOD_FILE"], len(genes), sig_modules),
    "method=STRING network (species=%d, required_score=%d, source=%s)"
    % (SPECIES, MIN_SCORE, source_label),
    "note=DEG 0 显著，PPI 输入取 WGCNA 与分组显著相关的模块基因；hub=degree top",
    "n_edges=%d n_genes_in_network=%d" % (len(edges_out), len(hub)),
    "top_hubs:",
]
for _, r in hub.head(15).iterrows():
    lines.append("  %-14s degree=%d" % (r["gene"], r["degree"]))
# 面板选择偏倚说明（Argon 第 44 轮 4A 裁定）。
# 靶向小面板（NanoString 免疫代谢 panel、定制 gene list）是围绕已知明星分子人工浓缩的，
# 其拓扑天然被设计者的先验知识塑形，破坏了「全基因组无偏抽样」这一 hub 分析的前提。
# 在这种面板上做 degree 中心性，很容易把「设计时就知道重要」的基因重新排到前面，
# 并误当成「新发现的 hub」。本报告必须把这件事写清楚，而不是只给 degree 排名。
n_input = len(genes)
# 判据用「来源类型」而非「基因数量」（第一版用 n_input<5000 判，结果把本例
# 5000 个 WGCNA 显著模块基因误判成 genome_scale）。理由：5000 往往是上游的截断上限，
# 不是全基因组规模；而 WGCNA 模块本身就是「按共表达筛选过的子集」，
# 且含 grey（未分配到任何模块的散点）时更是明确的非无偏输入。
is_wgcna_subset = ("wgcna" in os.environ.get("MOD_FILE", "").lower()) or ("grey" in sig_modules)
panel_kind = "targeted_panel" if is_wgcna_subset else "genome_scale"
if panel_kind == "targeted_panel":
    lines.append(
        "panel_selection_bias=1 kind=targeted_panel n_input=%d: "
        "输入是筛选过的子集（WGCNA 显著模块 / 靶向 panel），拓扑受筛选与设计先验影响，"
        "degree 排名只能读作「面板内部已知互作的相对中心性」，"
        "不得据此宣称发现新的 hub 基因。若要声称 hub 发现，需换成全基因组无偏输入。"
        % n_input
    )
else:
    lines.append(
        "panel_selection_bias=0 kind=genome_scale n_input=%d: "
        "输入规模接近全基因组量级，degree 中心性可作常规 hub 分析解读。" % n_input
    )
lines.append("edge_scope=%s (both=限定网络, any=一端在内会引入外部蛋白)" % SCOPE)
lines.append("outputs=ppi_edges.tsv, ppi_hubs.tsv, ../figures/l1_07_ppi_network.png, ../figures/l1_08_ppi_hubs.png, ppi_report.txt")
lines.append("elapsed_seconds=%.1f" % (time.time() - START))
with open("ppi_report.txt", "w", encoding="utf-8") as fh:
    fh.write("\n".join(lines) + "\n")
log("ppi_string_done")
# 句柄兜底（figure_spec 第 3 节 / Argon 第 65 轮 Q3）：逐图 close(fig) 已在 save() 内执行，
# 这里再 close("all") 兜住异常分支的残留图，防单步跑多图时峰值内存叠加。
plt.close("all")
PYSCRIPT
